-- sea event scan + spawn alerts (held until the splash is gone so the first toasts are visible)
task.spawn(function()
	repeat task.wait(0.25) until State.booted or not State.running
	local seen = {}
	while State.running do
		local ok, list = pcall(Sea.scan)
		if ok then
			Sea.list = list
			local now, hrp = {}, root()
			for _, ev in ipairs(list) do
				local fresh = true
				for _, m in ipairs(ev.models) do
					if seen[m] then fresh = false end
					now[m] = true
				end
				if fresh and State.seaAlerts then
					notify(Sea.title(ev) .. " spotted · " .. Sea.detail(ev, hrp), Sea.KIND[ev.kind].color, 6)
				end
			end
			seen = now
		end
		task.wait(1)
	end
end)

-- sea esp refresh
task.spawn(function()
	while State.running do
		task.wait(0.25)
		local live = {}
		if State.seaEsp then
			for _, ev in ipairs(Sea.list) do
				live[ev.anchor] = ev
				if not Sea.esp[ev.anchor] then Sea.addEsp(ev) end
			end
		end
		local hrp = root()
		for anchor, e in pairs(Sea.esp) do
			local ev = live[anchor]
			if not ev or not Sea.worldPos(anchor) then
				Sea.removeEsp(anchor)
			else
				e.label.Text = string.format('%s\n<font size="11" color="#c8d0da">%s</font>', Sea.title(ev), Sea.detail(ev, hrp))
			end
		end
	end
end)

-- player esp refresh
task.spawn(function()
	while State.running do
		task.wait(0.2)
		local hrp = root()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local char = p.Character
				local e = PlayerEsp.entries[p]
				-- respawns hand over a fresh character: rebuild on the new one
				if e and (not State.playerEsp or e.char ~= char or not char.Parent) then
					PlayerEsp.remove(p)
					e = nil
				end
				if State.playerEsp and char and char.Parent and not e then
					PlayerEsp.add(p, char)
					e = PlayerEsp.entries[p]
				end
				if e then PlayerEsp.update(p, e, hrp) end
			end
		end
		for p in pairs(PlayerEsp.entries) do
			if p.Parent ~= Players then PlayerEsp.remove(p) end
		end
	end
end)

