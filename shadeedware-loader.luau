local function makeTab(name, order)
	local btn = new("TextButton", {
		Parent = nav, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = T.panel, BackgroundTransparency = 1, AutoButtonColor = false,
		Text = "",
	}, { corner(9) })

	local bar = new("Frame", {
		Parent = btn, Size = UDim2.fromOffset(3, 0), Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = T.accent, BorderSizePixel = 0,
	}, { corner(2) })

	local lbl = new("TextLabel", {
		Parent = btn, Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(14, 0),
		BackgroundTransparency = 1, Text = name, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.muted,
	})

	local page = new("ScrollingFrame", {
		Parent = pages, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Visible = false, ScrollBarThickness = 3, ScrollBarImageColor3 = T.stroke,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 12, 0, 10),
	})

	local tab = { btn = btn, lbl = lbl, bar = bar, page = page }
	tabs[#tabs + 1] = tab

	local function select()
		for _, t in ipairs(tabs) do
			local on = t == tab
			t.page.Visible = on
			tween(t.btn, 0.18, { BackgroundTransparency = on and 0 or 1 })
			tween(t.lbl, 0.18, { TextColor3 = on and T.text or T.muted })
			tween(t.bar, 0.22, { Size = UDim2.fromOffset(3, on and 16 or 0) })
		end
		currentTab = tab
	end
	btn.MouseButton1Click:Connect(select)
	btn.MouseEnter:Connect(function()
		if currentTab ~= tab then tween(lbl, 0.15, { TextColor3 = T.text }) end
	end)
	btn.MouseLeave:Connect(function()
		if currentTab ~= tab then tween(lbl, 0.15, { TextColor3 = T.muted }) end
	end)
	tab.select = select
	return page, select
end

