end
local function root()
	local c = character()
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function alive()
	local h, r = humanoid(), root()
	return h ~= nil and r ~= nil and h.Health > 0
end

----------------------------------------------------------------------
-- movement: noclip + hover while flying, cancellable by token
----------------------------------------------------------------------
local floatBV
local collideBackup = {}

local function setFloat(on)
	State.floating = on
	if on then return end
	if floatBV then floatBV:Destroy(); floatBV = nil end
	for part in pairs(collideBackup) do
		if part.Parent then part.CanCollide = true end
	end
	table.clear(collideBackup)
end

conns[#conns + 1] = RunService.Stepped:Connect(function()
	if not State.floating then return end
	local c, hrp = character(), root()
	if not (c and hrp) then return end

	for _, p in ipairs(c:GetChildren()) do
		if p:IsA("BasePart") and p.CanCollide then
			collideBackup[p] = true
			p.CanCollide = false
		end
	end

	-- hold the body in place between our CFrame writes so gravity doesn't drag it down
	if not floatBV or floatBV.Parent ~= hrp then
		if floatBV then floatBV:Destroy() end
		floatBV = new("BodyVelocity", {
			Name = tostring(math.random(1e5, 1e6)), MaxForce = Vector3.one * math.huge, Velocity = Vector3.zero, P = 1e4,
			Parent = hrp,
		})
	end

	local h = humanoid()
	if h and h.Sit then h.Sit = false end
end)

local moveToken = 0
local function stopMove() moveToken += 1 end

-- goal: CFrame | Vector3 | function returning either (nil cancels)
local function flyTo(goal, arriveDist)
	moveToken += 1
	local my = moveToken
	arriveDist = arriveDist or 3
	setFloat(true)

	while State.running and my == moveToken do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
		if my ~= moveToken then return false end

		local hrp = root()
		if not alive() then return false end

		local target = type(goal) == "function" and goal() or goal
		if target == nil then return false end
		if typeof(target) == "Vector3" then target = CFrame.new(target) end

		local delta = target.Position - hrp.Position
		local dist = delta.Magnitude
		if dist <= arriveDist then
			hrp.CFrame = target
			hrp.AssemblyLinearVelocity = Vector3.zero
			return true
		end

		local step = math.min(dist, State.flySpeed * dt)
		hrp.CFrame = CFrame.new(hrp.Position + delta.Unit * step) * target.Rotation
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	return false
end

-- Sea 1: Underwater City sits ~60k studs out; the game moves you there with requestEntrance
local function underwater(pos) return SEA == 1 and pos.X > 30000 end

local function crossWater(goInside)
	local ts = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("TeleportSpawn")
	if not ts then return false end
	local door = ts:FindFirstChild(goInside and "Entrance" or "Exit")
	local dest = ts:FindFirstChild(goInside and "EntrancePoint" or "ExitPoint")
	if not (door and dest) then return false end

	setStatus(goInside and "Entering Underwater City" or "Leaving Underwater City")
	if not flyTo(door.Position + Vector3.new(0, 4, 0), 4) then return false end

	commF("requestEntrance", dest.Position)
	local t0 = os.clock()
	repeat
		task.wait(0.1)
		local hrp = root()
		if hrp and underwater(hrp.Position) == goInside then return true end
	until os.clock() - t0 > 4
	return false
end

local function goTo(goal, arriveDist)
	if SEA == 1 then
		local target = type(goal) == "function" and goal() or goal
		local hrp = root()
		if target and hrp then
			local tp = typeof(target) == "CFrame" and target.Position or target
			local want = underwater(tp)
			if want ~= underwater(hrp.Position) and not crossWater(want) then
				return false
			end
		end
	end
	return flyTo(goal, arriveDist)
end

----------------------------------------------------------------------
-- quests
----------------------------------------------------------------------
local questFails = {}

local function vec(v, fallback)
	if typeof(v) == "Vector3" then return v end
	if type(v) == "vector" then return Vector3.new(v.x, v.y, v.z) end
	return fallback
end

local function allQuests()
	local out = {}
	local list = GuideModule.Data and GuideModule.Data.NPCList
	if type(list) ~= "table" then return out end

	for npc, info in pairs(list) do
		local qs = type(info) == "table" and Quests[info.InternalQuestName]
		if type(qs) == "table" then
			local npcPart = typeof(npc) == "Instance" and npc:IsA("BasePart") and npc or nil
			local npcPos = vec(info.Position, npcPart and npcPart.Position)
			for i, q in ipairs(qs) do
				local enemy, count = next(q.Task or {})
				if enemy and npcPos then
					out[#out + 1] = {
						key = info.InternalQuestName .. "#" .. i,
						quest = info.InternalQuestName,
						index = i,
						title = q.Name,
						-- DialoguesList.Util labels a lone quest "Quest", otherwise ShortName / Name
						optionText = #qs > 1 and (q.ShortName or q.Name or "Quest") or "Quest",
						levelReq = q.LevelReq or 0,
						enemy = enemy,
						count = count,
						boss = count == 1,
						npcName = info.NPCName or info.InternalQuestName,
						npcPos = npcPos,
						npcPart = npcPart,
					}
				end
			end
		end
	end
	return out
end

-- the two starter quests are team-locked
local function teamAllows(questName)
	local marines = LocalPlayer.Team and LocalPlayer.Team.Name == "Marines"
	if questName == "BanditQuest1" then return not marines end
	if questName == "MarineQuest" then return marines end
	return true
end

local function pickQuest(level)
	local hrp = root()
	local here = hrp and hrp.Position or Vector3.zero
	local best
	for _, q in ipairs(allQuests()) do
		if q.levelReq <= level
			and (questFails[q.key] or 0) < 3
			and not (State.skipBosses and q.boss)
			and teamAllows(q.quest)
		then
			if not best
				or q.levelReq > best.levelReq
				or (q.levelReq == best.levelReq and (q.npcPos - here).Magnitude < (best.npcPos - here).Magnitude)
			then
				best = q
			end
		end
	end
	return best
end

-- GuideData mirrors the server's QuestUpdate event:
-- { InternalQuestName, Info = { Name, Task, LevelReq }, Progress = { [enemy] = n } } or nil.
-- The HUD quest frame can't be trusted: an open dialogue disables the whole Main gui.
local function activeQuest()
	local d = GuideData.Data
	local qd = d and d.QuestData
	return type(qd) == "table" and qd or nil
end

local function questMatches(qd, q)
	return qd.InternalQuestName == q.quest and qd.Info ~= nil and qd.Info.Name == q.title
end

local function questFromData(qd)
	for _, q in ipairs(allQuests()) do
		if questMatches(qd, q) then return q end
	end
	return nil
end

local function questProgress()
	local qd = activeQuest()
	if not (qd and qd.Info and qd.Info.Task) then return nil end
	local enemy, count = next(qd.Info.Task)
	local done = qd.Progress and qd.Progress[enemy] or 0
	return string.format("%s %d/%d", tostring(enemy), done, count or 0)
end

----------------------------------------------------------------------
-- npc dialogue (React DialogueGui: option rows are "button" TextButtons, one TextLabel per letter)
----------------------------------------------------------------------
local CLOSE_OPTIONS = { "Nevermind", "Goodbye", "Bye", "Leave", "Close", "Return", "Back" }

local function norm(s)
	return string.lower((string.gsub(s, "[^%w]", "")))
end

local function optionLabel(button)
	local letters = {}
	for _, t in ipairs(button:GetDescendants()) do
		if t:IsA("TextLabel") and #t.Text > 0 then letters[#letters + 1] = t end
	end
	table.sort(letters, function(a, b)
		if math.abs(a.AbsolutePosition.Y - b.AbsolutePosition.Y) > 6 then
			return a.AbsolutePosition.Y < b.AbsolutePosition.Y
		end
		return a.AbsolutePosition.X < b.AbsolutePosition.X
	end)
	local s = ""
	for _, t in ipairs(letters) do s ..= t.Text end
	return s
end

local function dialogueOptions()
	local out = {}
	local dg = PlayerGui:FindFirstChild("DialogueGui")
	if not dg then return out end
	for _, b in ipairs(dg:GetDescendants()) do
		if b:IsA("TextButton") and b.Name == "button" and b.Visible then
			out[#out + 1] = { button = b, text = optionLabel(b) }
		end
	end
	return out
end

local function findOption(wanted)
	for _, o in ipairs(dialogueOptions()) do
		local t = norm(o.text)
		for _, w in ipairs(wanted) do
			if t == norm(w) then return o.button end
		end
	end
	return nil
end

-- letters type in one at a time, so poll until the whole label matches
local function waitOption(wanted, timeout)
	local t0 = os.clock()
	repeat
		local b = findOption(wanted)
		if b then return b end
		task.wait(0.1)
	until os.clock() - t0 > timeout or not State.running
	return nil
end

local function clickOption(button)
	-- OptionButton ignores activations for 0.2s after it mounts
	task.wait(0.3)
	if not button.Parent then return false end
	return fireListeners(button.Activated)
end

local function closeDialogue()
	for _ = 1, 4 do
		local b = findOption(CLOSE_OPTIONS)
		if not b then return end
		clickOption(b)
		task.wait(0.35)
	end
end

local function waitForQuest(q, timeout)
	local t0 = os.clock()
	repeat
		local qd = activeQuest()
		if qd and questMatches(qd, q) then return true end
		task.wait(0.1)
	until os.clock() - t0 > timeout
	return false
end

-- NPCManager only opens a dialogue on a real mouse click next to the NPC; startDialogue(npc) is its
-- programmatic entry. Needs game identity (require fails from the executor's), and yields while open.
local npcManager
local function openNpcDialogue(q)
	task.spawn(function()
		if setthreadidentity then pcall(setthreadidentity, 2) end
		if npcManager == nil then
			local ok, m = pcall(require, ReplicatedStorage:WaitForChild("NPCManager", 5))
			npcManager = ok and type(m) == "table" and m or false
		end
		if not npcManager then return end

		local okList, list = pcall(npcManager.getNPCsByName, q.npcName)
		local best, bestDist
		for _, npc in ipairs(okList and list or {}) do
			local okModel, model = pcall(npc.getModel, npc)
			if okModel and model then
				local d = (model:GetPivot().Position - q.npcPos).Magnitude
				if not best or d < bestDist then best, bestDist = npc, d end
			end
		end
		if best then pcall(npcManager.startDialogue, best) end
	end)
end

-- Quest → [pick quest] → Accept, exactly like a player; remote StartQuest only if the window never shows
local function acceptQuest(q)
	State.inDialogue = true
	local ok = false

	if not findOption({ q.optionText }) then
		task.wait(0.6) -- let the landing settle; the NPC isn't interactable mid-air
		openNpcDialogue(q)
	end

	local pick = waitOption({ q.optionText }, 2.5)
	if not pick then
		-- givers parked in ReplicatedStorage.NPCs stream in on arrival and refuse the first open
		openNpcDialogue(q)
		pick = waitOption({ q.optionText }, 3)
	end
	if pick then
		setStatus("Selecting " .. (q.title or "quest"))
		clickOption(pick)
		local accept = waitOption({ "Accept" }, 3)
		if accept then
			setStatus("Accepting " .. (q.title or "quest"))
			clickOption(accept)
			ok = waitForQuest(q, 3)
			if ok then State.lastAcceptVia = "dialogue" end
		end
	end

	if not ok and not activeQuest() then
		commF("StartQuest", q.quest, q.index)
		ok = waitForQuest(q, 2)
		if ok then State.lastAcceptVia = "remote" end
	end

	-- the "[Quest accepted.]" page advances on its own; clear whatever is left
	task.wait(0.8)
	closeDialogue()
	State.inDialogue = false
	return ok
end

----------------------------------------------------------------------
-- combat
----------------------------------------------------------------------
local function findWeapon()
	local c = character()
	for _, container in ipairs({ c, LocalPlayer:FindFirstChild("Backpack") }) do
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") and t.ToolTip == State.weapon then return t end
			end
		end
	end
	if State.weapon ~= "Melee" then
		for _, container in ipairs({ c, LocalPlayer:FindFirstChild("Backpack") }) do
			if container then
				for _, t in ipairs(container:GetChildren()) do
					if t:IsA("Tool") and t.ToolTip == "Melee" then return t end
				end
			end
		end
	end
	return nil
end

local function equipWeapon()
	local c, h = character(), humanoid()
	if not (c and h) then return nil end
	local tool = findWeapon()
	if tool and tool.Parent ~= c then
		pcall(h.EquipTool, h, tool)
	end
	return tool
end

local function hitPart(model)
	return model:FindFirstChild("Head")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("ModelHitbox")
end

local combo = 0
local function attack(enemy)
	if State.fastAttack then
		local part = hitPart(enemy)
		if not part then return end
		-- SendHitsToServer resumes CombatUtil's hit thread; resumed from an executor-identity thread
		-- it silently sends nothing (measured: 0 damage at identity 8, 9 per hit at identity 2)
		if setthreadidentity then pcall(setthreadidentity, 2) end
		combo = combo % 4 + 1
		-- same pair the CombatController sends per swing: RegisterAttack(animLength, combo), then the hit,
		-- which Net wraps into the rotating virtual remote with its time-keyed name
		RegisterAttack:FireServer(0.5, combo)
		if type(Global.SendHitsToServer) == "function" then
			Global.SendHitsToServer(part, {})
		end
	else
		VirtualUser:CaptureController()
		VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
		task.wait(0.05)
		VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
	end
end

local function enemyAlive(e)
	local h = e and e.Parent and e:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0 and e:FindFirstChild("HumanoidRootPart") ~= nil
end

local function findEnemy(name)
	local hrp = root()
	local best, bestDist
	for _, e in ipairs(EnemiesFolder:GetChildren()) do
		if e.Name == name and enemyAlive(e) then
			local d = hrp and (e.HumanoidRootPart.Position - hrp.Position).Magnitude or 0
			if not best or d < bestDist then best, bestDist = e, d end
		end
	end
	return best
end

local function enemySpawns(name)
	local out = {}
	local folder = WorldOrigin:FindFirstChild("EnemySpawns")
	if not folder then return out end
	local prefix = name .. " ["
	for _, s in ipairs(folder:GetChildren()) do
		if s:IsA("BasePart") and string.sub(s.Name, 1, #prefix) == prefix then
			out[#out + 1] = s
		end
	end
	return out
end

local function farmTarget(enemy, q)
	local eroot = enemy.HumanoidRootPart
	local ehum = enemy:FindFirstChildOfClass("Humanoid")
	State.targetLabel = enemy.Name

	local function hoverCF()
		if not enemyAlive(enemy) then return nil end
		local cf = CFrame.new(eroot.Position + Vector3.new(0, State.farmHeight, 0))
		if State.fastAttack then return cf end
		-- simulated clicks go through the client hitbox, which only reaches in front: face straight down
		return cf * CFrame.Angles(-math.pi / 2, 0, 0)
	end

	setStatus("Flying to " .. enemy.Name)
	if not goTo(hoverCF, 6) then return end

	setStatus("Farming " .. enemy.Name)
	local my = moveToken
	local lastSwing = 0
	local lastDialogueCheck = 0

	while State.running and State.autoLevel and not State.fruitBusy and not State.manualMove
		and my == moveToken and enemyAlive(enemy) and alive()
	do
		local qd = activeQuest()
		if not qd or not questMatches(qd, q) then break end

		-- mobs next to a quest giver can drag its dialogue open mid-fight; it disables the HUD
		if os.clock() - lastDialogueCheck > 0.75 then
			lastDialogueCheck = os.clock()
			if findOption(CLOSE_OPTIONS) then task.spawn(closeDialogue) end
		end

		local cf = hoverCF()
		if not cf then break end
		local hrp = root()

		if (hrp.Position - cf.Position).Magnitude > 40 then
			if not goTo(hoverCF, 6) then break end
			my = moveToken
		else
			hrp.CFrame = cf
			hrp.AssemblyLinearVelocity = Vector3.zero
		end

		if os.clock() - lastSwing >= State.attackDelay then
			lastSwing = os.clock()
			equipWeapon()
			task.spawn(attack, enemy)
		end

		RunService.Heartbeat:Wait()
	end

	if ehum and ehum.Health <= 0 then
		State.kills += 1
	end
end

local spawnCursor = 0

local function levelTick()
	if not alive() then
		setStatus("Waiting for respawn")
		setFloat(false)
		task.wait(1)
		return
	end

	local level = Data.Level.Value
	local qd = activeQuest()
	local q

	if qd then
		q = questFromData(qd)
		if not q or (State.skipBosses and q.boss) then
			setStatus("Dropping unrelated quest")
			commF("AbandonQuest")
			task.wait(0.5)
			return
		end
	else
		q = pickQuest(level)
		if not q then
			setStatus("No quest available at Lv. " .. level)
			task.wait(2)
			return
		end

		State.questLabel = string.format("%s · %s ×%d", q.npcName, q.enemy, q.count)
		setStatus("Going to " .. q.npcName)

		-- land a few studs in front of the giver: its dialogue only opens for a grounded player in range
		local look = q.npcPart and q.npcPart.CFrame.LookVector * Vector3.new(1, 0, 1) or Vector3.zero
		if look.Magnitude < 0.1 then look = Vector3.new(0, 0, -1) end
		local standAt = q.npcPos + look.Unit * 5
		if not goTo(CFrame.lookAt(standAt, Vector3.new(q.npcPos.X, standAt.Y, q.npcPos.Z)), 3) then return end
		setFloat(false)
		if not State.autoLevel then return end

		setStatus("Talking to " .. q.npcName)
		if acceptQuest(q) then
			State.questsTaken += 1
			questFails[q.key] = nil
			notify("Quest accepted: " .. q.enemy .. " ×" .. q.count)
		else
			questFails[q.key] = (questFails[q.key] or 0) + 1
			if questFails[q.key] >= 3 then
				notify("Skipping " .. q.key .. " (server keeps refusing it)", T.danger)
			end
		end
		return
	end

	State.questLabel = string.format("%s · %s ×%d", q.npcName, q.enemy, q.count)

	local enemy = findEnemy(q.enemy)
	if enemy then
		farmTarget(enemy, q)
		return
	end

	-- nothing loaded nearby: sweep the enemy's spawn points until some replicate in
	State.targetLabel = q.enemy .. " (searching)"
	local points = {}
	for _, s in ipairs(enemySpawns(q.enemy)) do points[#points + 1] = s.Position end

	-- starter mobs have no EnemySpawns marker; the client parks out-of-range copies in ReplicatedStorage
	if #points == 0 then
		for _, m in ipairs(ReplicatedStorage:GetChildren()) do
			local r = m.Name == q.enemy and m:IsA("Model") and m:FindFirstChild("HumanoidRootPart")
			if r then points[#points + 1] = r.Position end
		end
	end
	if #points == 0 then points[1] = q.npcPos end

	spawnCursor = spawnCursor % #points + 1
	setStatus("Searching for " .. q.enemy)
	if not goTo(CFrame.new(points[spawnCursor] + Vector3.new(0, 25, 0)), 5) then return end

	local t0 = os.clock()
	while os.clock() - t0 < 2.5 and State.autoLevel and not State.fruitBusy do
		if findEnemy(q.enemy) then return end
		task.wait(0.2)
	end
end

----------------------------------------------------------------------
-- fruits
----------------------------------------------------------------------
local function isFruit(inst)
	return inst:IsA("Tool")
		and inst.Parent == workspace
		and (inst:GetAttribute("OriginalName") ~= nil or string.find(inst.Name, "Fruit$") ~= nil)
end

local function fruitRarity(tool)
	local id = tool:GetAttribute("OriginalName")
	if not id then return "Unknown" end
	local ok, info = pcall(FruitInfo.TryGet, FruitInfo, id)
	return ok and info and info.Rarity and info.Rarity.Name or "Unknown"
end

local function fruitsInServer()
	local out = {}
	for _, c in ipairs(workspace:GetChildren()) do
		if isFruit(c) and c:FindFirstChild("Handle") then out[#out + 1] = c end
	end
	local hrp = root()
	if hrp then
		table.sort(out, function(a, b)
			return (a.Handle.Position - hrp.Position).Magnitude < (b.Handle.Position - hrp.Position).Magnitude
		end)
	end
	return out
end

local esp = {} -- [tool] = { bb, label, hl }

local function removeEsp(tool)
	local e = esp[tool]
	if not e then return end
	e.bb:Destroy()
	e.hl:Destroy()
	esp[tool] = nil
end

local function addEsp(tool)
	if esp[tool] then return end
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	local rarity = fruitRarity(tool)
	local col = RARITY_COLOR[rarity] or T.text

	local bb = new("BillboardGui", {
		Parent = espFolder, Adornee = handle, AlwaysOnTop = true,
		Size = UDim2.fromOffset(200, 38), StudsOffset = Vector3.new(0, 3, 0),
		LightInfluence = 0,
	})
	local label = new("TextLabel", {
		Parent = bb, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = tool.Name, RichText = true,
		Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = col,
		TextStrokeTransparency = 0.35, TextStrokeColor3 = Color3.new(0, 0, 0),
	})
	local hl = new("Highlight", {
		Parent = espFolder, Adornee = tool,
		FillColor = col, FillTransparency = 0.55,
		OutlineColor = col, OutlineTransparency = 0,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	})
	esp[tool] = { bb = bb, label = label, hl = hl, rarity = rarity }
end

local function clearEsp()
	for tool in pairs(esp) do removeEsp(tool) end
end

local function holdingFruit(tool)
	local c = character()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	return tool.Parent ~= nil and (tool.Parent == c or tool.Parent == bp)
end

local function collectFruit(tool)
	if State.fruitBusy or not (tool and tool.Parent == workspace) then return false end
	local handle = tool:FindFirstChild("Handle") or tool:WaitForChild("Handle", 5)
	if not handle then return false end

	State.fruitBusy = true
	stopMove()
	local name = tool.Name
	local id = tool:GetAttribute("OriginalName")
	setStatus("Collecting " .. name)

	-- position only: the FruitAnimator spins the handle, copying its rotation would spin you too
	local reached = goTo(function()
		if tool.Parent ~= workspace then return nil end
		return CFrame.new(handle.Position)
	end, 2)

	-- stand on the handle until the pickup lands
	local t0 = os.clock()
	while reached and tool.Parent == workspace and os.clock() - t0 < 3 and alive() do
		local hrp = root()
		hrp.CFrame = CFrame.new(handle.Position)
		if firetouchinterest then
			pcall(firetouchinterest, hrp, handle, 0)
			pcall(firetouchinterest, hrp, handle, 1)
		end
		RunService.Heartbeat:Wait()
	end

	local picked = holdingFruit(tool)
	if picked then
		State.fruitsCollected += 1
		notify("Picked up " .. name, RARITY_COLOR[fruitRarity(tool)])

		if State.autoStore and id then
			local h = humanoid()
			if h and tool.Parent ~= character() then pcall(h.EquipTool, h, tool) end
			task.wait(0.35)
			local res = commF("StoreFruit", id, tool)
			task.wait(0.5)
			if typeof(res) == "number" then
				notify("Fruit storage full (" .. res .. " max) — kept " .. name, T.danger, 4)
			elseif tool.Parent == nil or not holdingFruit(tool) then
				notify("Stored " .. name, T.accent)
			end
		end
	elseif tool.Parent ~= workspace then
		notify(name .. " was taken first", T.danger)
	end

	setFloat(false)
	State.fruitBusy = false
	return picked
end

local function announceFruit(tool)
	if not State.fruitAlerts then return end
	local handle = tool:FindFirstChild("Handle") or tool:WaitForChild("Handle", 5)
	local hrp = root()
	local dist = (handle and hrp) and math.floor((handle.Position - hrp.Position).Magnitude / 10) or 0
	local rarity = fruitRarity(tool)
	notify(string.format("%s spawned · %s · %dm", tool.Name, rarity, dist), RARITY_COLOR[rarity], 5)
end

conns[#conns + 1] = workspace.ChildAdded:Connect(function(child)
	task.defer(function()
		if not State.running or not isFruit(child) then return end
		if not child:FindFirstChild("Handle") then child:WaitForChild("Handle", 5) end
		announceFruit(child)
		if State.fruitEsp then addEsp(child) end
	end)
end)

----------------------------------------------------------------------
-- sea events
----------------------------------------------------------------------
-- The main chunk sits near Luau's 200-local ceiling, so the newer systems keep their helpers inside
-- do-blocks and hand out one table each.
local Sea = { list = {}, esp = {} }

do
	local CollectionService = game:GetService("CollectionService")

	Sea.KIND = {
		Island = { color = RARITY_COLOR.Legendary, noun = "event island" },
		Beast  = { color = T.danger, noun = "sea boss", hover = 60 },
		Ship   = { color = T.accent, noun = "enemy ship", hover = 35 },
		Mob    = { color = T.accent2, noun = "sea mobs", hover = 30 },
		Zone   = { color = Color3.fromRGB(96, 214, 190), noun = "sea zone" },
	}

	-- { name pattern, label (false = the model's own name), kind, one creature split over several rigs }
	-- No sea event was up while the rest of this was read out of the client, so these are the names the
	-- community uses. Anything else that can fight and sits out in open water is listed under its own name.
	local SEA_MOBS = {
		{ "Leviathan", "Leviathan", "Beast", true },
		{ "^SeaBeast", "Sea Beast", "Beast" },
		{ "^Terrorshark", "Terrorshark", "Beast" },
		{ "Piranha", "Piranha", "Mob" },
		{ "^Shark$", "Shark", "Mob" },
		{ "Crew Member$", false, "Mob" },
		{ "Brigade$", false, "Ship" },
		{ "^FishBoat", false, "Ship" },
	}

	-- event islands spawn under workspace.Map; the anchor is the part the game's own effects aim at
	local SEA_ISLANDS = {
		{ "KitsuneIsland", "Kitsune Island", { "optimizedcylinder" } },
		{ "PrehistoricIsland", "Prehistoric Island", { "Core", "RockLandingZone" } },
	}

	-- LightingZones the server drops where an event is
	local SEA_ZONES = {
		MirageIsland = { "Mirage Island", "Island" },
		RumblingSeas = { "Rumbling Seas", "Zone" },
		Leviathan    = { "Leviathan zone", "Zone" },
	}

	local function pretty(name)
		return (string.gsub(name, "(%l)(%u)", "%1 %2"))
	end

	local function worldPos(inst)
		if not (inst and inst.Parent) then return nil end
		if inst:IsA("BasePart") then return inst.Position end
		if inst:IsA("Attachment") then return inst.WorldPosition end
		if inst:IsA("Model") then
			local r = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
			return r and r.Position or inst:GetPivot().Position
		end
		return nil
	end
	Sea.worldPos = worldPos

	local function modelHealth(inst)
		local h = inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid")
		if h and h.MaxHealth > 0 then return h.Health / h.MaxHealth end
		return nil
	end

	function Sea.fmtDist(studs)
		local m = studs / 10
		if m >= 1000 then return string.format("%.1fkm", m / 1000) end
		return string.format("%dm", math.floor(m))
	end

	function Sea.title(ev)
		return ev.count > 1 and (ev.label .. " ×" .. ev.count) or ev.label
	end

	function Sea.detail(ev, hrp)
		local bits = { Sea.KIND[ev.kind].noun }
		local hp = modelHealth(ev.anchor)
		if hp then bits[#bits + 1] = string.format("%d%% hp", math.floor(hp * 100 + 0.5)) end
		local p = worldPos(ev.anchor)
		if p and hrp then bits[#bits + 1] = Sea.fmtDist((p - hrp.Position).Magnitude) end
		return table.concat(bits, " · ")
	end

	-- -> { { label, kind, anchor, models, count } } nearest first
	function Sea.scan()
		local events, byLabel = {}, {}

		local function addPlace(label, kind, anchor)
			if byLabel[label] or not worldPos(anchor) then return end
			local ev = { label = label, kind = kind, anchor = anchor, models = { anchor }, count = 1 }
			byLabel[label] = ev
			events[#events + 1] = ev
		end

		local map = workspace:FindFirstChild("Map")
		for _, isl in ipairs(SEA_ISLANDS) do
			local m = map and map:FindFirstChild(isl[1])
			if m then
				local anchor = m
				for _, name in ipairs(isl[3]) do anchor = anchor and anchor:FindFirstChild(name) end
				addPlace(isl[2], "Island", anchor or m)
			end
		end

		local lz = WorldOrigin:FindFirstChild("LightingZones")
		for name, info in pairs(SEA_ZONES) do
			local z = lz and lz:FindFirstChild(name)
			if z then addPlace(info[1], info[2], z) end
		end

		-- SeaEvent / IslandEvent zones only exist while the event is up; Island zones mark where land is
		local islandZones = {}
		for _, p in ipairs(CollectionService:GetTagged("ClientEnvironment")) do
			local group = p:GetAttribute("Group")
			if group == "IslandEvent" or group == "SeaEvent" then
				addPlace(tostring(p:GetAttribute("Name") or p.Name), group == "IslandEvent" and "Island" or "Zone", p)
			elseif group == "Island" and p:IsA("BasePart") then
				islandZones[#islandZones + 1] = { p.Position * Vector3.new(1, 0, 1), tonumber(p:GetAttribute("Radius")) or 0 }
			end
		end

		-- no island zones to test against means everything would look like open water
		local function atSea(pos)
			if #islandZones == 0 or pos.Y > 300 then return false end
			local flat = pos * Vector3.new(1, 0, 1)
			for _, z in ipairs(islandZones) do
				if (flat - z[1]).Magnitude <= z[2] then return false end
			end
			return true
		end

		-- a swarm reads as one event: same label within 800 studs joins the same cluster
		local clusters = {}
		local function addMob(model, label, kind, single)
			local pos = worldPos(model)
			if not pos then return end
			for _, c in ipairs(clusters) do
				if c.label == label and (c.pos - pos).Magnitude < 800 then
					c.models[#c.models + 1] = model
					if not single then c.count += 1 end
					return
				end
			end
			clusters[#clusters + 1] = { label = label, kind = kind, anchor = model, pos = pos, models = { model }, count = 1 }
		end

		local function scanFolder(folder, isBeasts)
			if not folder then return end
			for _, m in ipairs(folder:GetChildren()) do
				local h = m:IsA("Model") and m:FindFirstChildOfClass("Humanoid")
				if (h or (isBeasts and m:IsA("Model"))) and (not h or h.Health > 0) then
					local label, kind, single
					for _, rule in ipairs(SEA_MOBS) do
						if string.find(m.Name, rule[1]) then
							label, kind, single = rule[2] or pretty(m.Name), rule[3], rule[4]
							break
						end
					end
					if not label then
						if isBeasts then
							label, kind = "Sea Beast", "Beast"
						else
							local pos = worldPos(m)
							if pos and atSea(pos) then label, kind = pretty(m.Name), "Mob" end
						end
					end
					if label then addMob(m, label, kind, single) end
				end
			end
		end
		scanFolder(workspace:FindFirstChild("SeaBeasts"), true)
		scanFolder(EnemiesFolder, false)
		scanFolder(ReplicatedStorage, false)

		for _, c in ipairs(clusters) do events[#events + 1] = c end

		local hrp = root()
		if hrp then
			local here = hrp.Position
			local dist = {}
			for _, ev in ipairs(events) do dist[ev] = (worldPos(ev.anchor) - here).Magnitude end
			table.sort(events, function(a, b) return dist[a] < dist[b] end)
		end
		return events
	end

	function Sea.removeEsp(anchor)
		local e = Sea.esp[anchor]
		if not e then return end
		e.att:Destroy()
		e.bb:Destroy()
		if e.hl then e.hl:Destroy() end
		Sea.esp[anchor] = nil
	end

	function Sea.clearEsp()
		for anchor in pairs(Sea.esp) do Sea.removeEsp(anchor) end
	end

	-- The marker hangs off an Attachment in Terrain instead of the model itself: NPCStreaming parks
	-- mobs more than 1200 studs out in ReplicatedStorage, where a billboard on them wouldn't draw.
	function Sea.addEsp(ev)
		local col = Sea.KIND[ev.kind].color
		local att = new("Attachment", { Name = tostring(math.random(1e5, 1e6)), Parent = workspace.Terrain })
		local bb = new("BillboardGui", {
			Parent = espFolder, Adornee = att, AlwaysOnTop = true,
			Size = UDim2.fromOffset(220, 40), LightInfluence = 0,
		})
		local label = new("TextLabel", {
			Parent = bb, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = Sea.title(ev), RichText = true,
			Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = col,
			TextStrokeTransparency = 0.35, TextStrokeColor3 = Color3.new(0, 0, 0),
		})
		-- only bosses and ships get a Highlight: Roblox draws at most 31 at once, and a swarm would eat them
		local hl
		if (ev.kind == "Beast" or ev.kind == "Ship") and ev.anchor:IsA("Model") then
			hl = new("Highlight", {
				Parent = espFolder, Adornee = ev.anchor,
				FillColor = col, FillTransparency = 0.6,
				OutlineColor = col, OutlineTransparency = 0,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			})
		end
		Sea.esp[ev.anchor] = { att = att, bb = bb, label = label, hl = hl }
	end

	conns[#conns + 1] = RunService.RenderStepped:Connect(function()
		for anchor, e in pairs(Sea.esp) do
			local p = worldPos(anchor)
			if p then e.att.WorldPosition = p + Vector3.new(0, 10, 0) end
		end
	end)

	-- event islands have no spawn point: drop a ray from high above the anchor and land on what it hits
	function Sea.landingSpot(pos)
		local skip = { EnemiesFolder, WorldOrigin }
		local chars = workspace:FindFirstChild("Characters")
		if chars then skip[#skip + 1] = chars end
		if character() then skip[#skip + 1] = character() end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = skip
		local hit = workspace:Raycast(pos + Vector3.new(0, 2000, 0), Vector3.new(0, -4000, 0), params)
		return hit and hit.Position + Vector3.new(0, 8, 0) or pos + Vector3.new(0, 25, 0)
	end
end

----------------------------------------------------------------------
-- player esp
----------------------------------------------------------------------
local PlayerEsp = { entries = {} } -- entries[player] = { char, bb, label, hl }

do
	local HP_LOW, HP_HIGH = Color3.fromRGB(240, 96, 96), Color3.fromRGB(96, 214, 120)

	function PlayerEsp.remove(p)
		local e = PlayerEsp.entries[p]
		if not e then return end
		e.bb:Destroy()
		e.hl:Destroy()
		PlayerEsp.entries[p] = nil
	end

	function PlayerEsp.clear()
		for p in pairs(PlayerEsp.entries) do PlayerEsp.remove(p) end
	end

	function PlayerEsp.add(p, char)
		local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
		if not head then return end
		local bb = new("BillboardGui", {
			Parent = espFolder, Adornee = head, AlwaysOnTop = true,
			Size = UDim2.fromOffset(200, 36), StudsOffset = Vector3.new(0, 2.6, 0),
			LightInfluence = 0,
		})
		local label = new("TextLabel", {
			Parent = bb, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = p.Name, RichText = true,
			Font = Enum.Font.GothamBold, TextSize = 13,
			TextStrokeTransparency = 0.35, TextStrokeColor3 = Color3.new(0, 0, 0),
		})
		local hl = new("Highlight", {
			Parent = espFolder, Adornee = char,
			FillTransparency = 0.7, OutlineTransparency = 0.1,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		})
		PlayerEsp.entries[p] = { char = char, bb = bb, label = label, hl = hl }
	end

	function PlayerEsp.update(p, e, hrp)
		local col = p.Team and p.TeamColor.Color or T.text
		local h = e.char:FindFirstChildOfClass("Humanoid")
		local frac = h and h.MaxHealth > 0 and math.clamp(h.Health / h.MaxHealth, 0, 1) or 0
		local data = p:FindFirstChild("Data")
		local lvl = data and data:FindFirstChild("Level")
		local head = e.bb.Adornee
		local dist = (hrp and head and head.Parent) and Sea.fmtDist((head.Position - hrp.Position).Magnitude) or "?"

		e.label.TextColor3 = col
		e.hl.FillColor, e.hl.OutlineColor = col, col
		e.label.Text = string.format(
			'%s  <font size="11" color="#c8d0da">Lv. %s</font>\n<font size="11" color="#%s">%d%% hp</font><font size="11" color="#c8d0da"> · %s</font>',
			p.Name, lvl and tostring(lvl.Value) or "?", HP_LOW:Lerp(HP_HIGH, frac):ToHex(), math.floor(frac * 100 + 0.5), dist
		)
	end
end

----------------------------------------------------------------------
-- speed boost
----------------------------------------------------------------------
-- "Movement + Swim" works out WalkSpeed from race, buffs and running state and writes it every frame,
-- except while the character carries IgnoreWalkSpeed. Hold that flag and pin WalkSpeed before physics
-- steps; handing the flag back returns speed to the game, buffs and all.
local releaseBoost

do
	local boostChar, boostPrev

	function releaseBoost()
		if boostChar and boostChar.Parent then
			boostChar:SetAttribute("IgnoreWalkSpeed", boostPrev)
		end
		boostChar, boostPrev = nil, nil
	end

	conns[#conns + 1] = RunService.Stepped:Connect(function()
		if not State.speedBoost then
			if boostChar then releaseBoost() end
			return
		end
		local c, h = character(), humanoid()
		if not (c and h) or h.Health <= 0 then return end
		if boostChar ~= c then
			releaseBoost()
			boostChar, boostPrev = c, c:GetAttribute("IgnoreWalkSpeed")
		end
		if c:GetAttribute("IgnoreWalkSpeed") ~= true then c:SetAttribute("IgnoreWalkSpeed", true) end
		-- swimming writes WalkSpeed outside the flag check, so pin it every step rather than once
		if h.WalkSpeed ~= State.walkSpeed then h.WalkSpeed = State.walkSpeed end
	end)
end

