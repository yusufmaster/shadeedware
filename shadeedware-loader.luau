-- click, then press a key: rebinds to a keyboard key or a mouse button (Esc cancels)
local KEY_NAMES = {
	[Enum.UserInputType.MouseButton1] = "Left click",
	[Enum.UserInputType.MouseButton2] = "Right click",
	[Enum.UserInputType.MouseButton3] = "Middle click",
}
local function keyName(k)
	return KEY_NAMES[k] or k.Name
end

local function matchesKey(input, key)
	if key.EnumType == Enum.KeyCode then
		return input.KeyCode == key
	end
	return input.UserInputType == key
end

-- true while a keybind button waits for its key, so the key being bound doesn't also fire its action
local keyCapture = false

local function keybind(page, order, title, default, cb)
	local r = row(page, order, 42)
	new("TextLabel", {
		Parent = r, Size = UDim2.new(1, -130, 1, 0),
		BackgroundTransparency = 1, Text = title, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
	})
	local b = new("TextButton", {
		Parent = r, Size = UDim2.fromOffset(116, 24),
		Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = T.panel2, AutoButtonColor = false,
		Text = keyName(default), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.accent,
	}, { corner(7), stroke(T.stroke, 1, 0.3) })

	local current, listening = default, false
	b.MouseButton1Click:Connect(function()
		listening, keyCapture = true, true
		b.Text = "press a key…"
		b.TextColor3 = T.muted
	end)
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(i, gp)
		if not listening then return end
		local t, pick = i.UserInputType, nil
		if t == Enum.UserInputType.Keyboard then
			if i.KeyCode ~= Enum.KeyCode.Escape then pick = i.KeyCode end
		elseif t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
			pick = t
		elseif t == Enum.UserInputType.MouseButton1 and not gp then
			-- left click out in the world binds it; a click on another button in the ui doesn't
			pick = t
		else
			return
		end
		listening = false
		-- cleared once this input has reached every other listener
		task.defer(function() keyCapture = false end)
		if pick then
			current = pick
			task.spawn(cb, pick)
		end
		b.Text = keyName(current)
		b.TextColor3 = T.accent
	end)
end

----------------------------------------------------------------------
-- drawing helpers
----------------------------------------------------------------------
-- Without a Drawing API the circle and marker become inert stand-ins; the aimlock still works.
local function newDrawing(class, props)
	if not Drawing then
		return setmetatable({}, { __index = function() return function() end end })
	end
	local d = Drawing.new(class)
	for k, v in pairs(props) do
		d[k] = v
	end
	d.Visible = false
	return d
end

----------------------------------------------------------------------
-- projectile aimlock
----------------------------------------------------------------------
-- Hooked on the class so every caller gets it: the item launcher, the bow's aim preview beam
-- (which then bends onto the target while you draw), quick-cast bullets and the owl kit.
local Class, original
do
	local ok, ctrl = pcall(function()
		local projectile = LocalPlayer.PlayerScripts.TS.controllers.global.combat.projectile
		return require(projectile["projectile-controller"]).ProjectileController
	end)
	if ok and type(ctrl) == "table" then
		local mt = getmetatable(ctrl)
		Class = type(mt) == "table" and rawget(mt, "calculateImportantLaunchValues") and mt or ctrl
		original = Class.calculateImportantLaunchValues
	end
end
local HOOKABLE = type(original) == "function"

local ItemMeta
pcall(function()
	local m = require(ReplicatedStorage.TS.item["item-meta"])
	ItemMeta = m.items or m.ItemMeta
end)

local function heldItemName()
	local char = LocalPlayer.Character
	local v = char and char:FindFirstChild("HandInvItem")
	return v and v.Value and v.Value.Name or nil
end

local function shootsProjectiles(itemName)
	local m = ItemMeta and ItemMeta[itemName]
	return type(m) == "table" and m.projectileSource ~= nil
end

-- ProjectileUtil.fireProjectile spawns the model this far from positionFrom, in the launch direction's frame.
local SPAWN_OFFSET = CFrame.new(0.8, -0.6, 0)
local SOLVE_STEP = 1 / 60
local GROUND_PROBE = 200
-- A single ray down the middle slips past the block edge a player is standing on and finds ground
-- far below; a cast the width of their feet doesn't.
local FOOTPRINT = Vector3.new(1.6, 0.1, 1.6)
-- Lead fades out over this many seconds: short for strafing or a run that just began, long for a
-- steady run. Tuned on recorded movement: full lead overshot start-stop players by 9 studs at 0.8s.
local LEAD_TAU_MIN, LEAD_TAU_MAX = 0.3, 4
local TRACK_WINDOW = 0.5
-- Past this much flight the head is too small to lead reliably, so Auto sends headhunter arrows
-- at the body instead.
local HEADSHOT_MAX_FLIGHT = 0.45
local ARC_CHECKS = 8

local FOV_IDLE = Color3.fromRGB(255, 255, 255)
local FOV_LOCKED = Color3.fromRGB(80, 255, 120)

local fovCircle = newDrawing("Circle", { Thickness = 1, NumSides = 64, Filled = false, Color = FOV_IDLE })
local aimDot = newDrawing("Circle", { Radius = 4, NumSides = 16, Filled = true, Color = FOV_LOCKED })

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.IgnoreWater = true

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

local arcParams = RaycastParams.new()
arcParams.FilterType = Enum.RaycastFilterType.Exclude
arcParams.IgnoreWater = true

-- recent root positions per player, oldest first, so the lead can tell a steady run from strafing
local tracks = {}

local function trackPlayers()
	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			tracks[player] = nil
			continue
		end
		local tr = tracks[player]
		if not tr or tr.root ~= root then
			tr = { root = root }
			tracks[player] = tr
		end
		local last = tr[#tr]
		if not last or now - last[1] >= 1 / 60 then
			tr[#tr + 1] = { now, root.Position }
			while #tr > 2 and now - tr[2][1] >= TRACK_WINDOW do table.remove(tr, 1) end
		end
	end
	for player in pairs(tracks) do
		if player.Parent ~= Players then tracks[player] = nil end
	end
end

local lockHeld = false -- Hold: the lock key is down. Toggle: the lock is armed
local lockedPlayer = nil -- Hold / Toggle: who the lock grabbed
local lastLocked = nil

-- `name` is a projectile type or a held item; every headhunter variant has it in its name.
local function wantsHead(name)
	return AIM.part == "Head" or (AIM.part == "Auto" and name ~= nil and name:find("headhunter") ~= nil)
end

local function isTeammate(player)
	local theirs, mine = player:GetAttribute("Team"), LocalPlayer:GetAttribute("Team")
	if theirs ~= nil and mine ~= nil then
		return theirs == mine
	end
	return player.Team ~= nil and player.Team == LocalPlayer.Team
end

local function myPosition()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local cam = workspace.CurrentCamera
	return root and root.Position or (cam and cam.CFrame.Position) or Vector3.zero
end

-- the part to aim at plus the root and humanoid behind it, or nil when the player isn't hittable
local function aimPartOf(player, wantHead)
	if not player or not player.Parent then return nil end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then return nil end
	if AIM.teamCheck and isTeammate(player) then return nil end
	local head = wantHead and char:FindFirstChild("Head")
	return head or root, root, hum
end

local function isVisible(cam, part)
	wallParams.FilterDescendantsInstances = { cam, LocalPlayer.Character }
	local camPos = cam.CFrame.Position
	local hit = workspace:Raycast(camPos, part.Position - camPos, wallParams)
	return not hit or hit.Instance:IsDescendantOf(part.Parent)
end

local function pickTarget(wantHead)
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local cursor = UserInputService:GetMouseLocation()
	local origin = myPosition()

	local best, bestPart, bestRoot, bestHum, bestScore
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local part, root, hum = aimPartOf(player, wantHead)
		if not part then continue end
		local worldDist = (part.Position - origin).Magnitude
		if worldDist > AIM.maxDistance then continue end
		local screen = cam:WorldToViewportPoint(part.Position)
		if screen.Z <= 0 then continue end
		local cursorDist = (Vector2.new(screen.X, screen.Y) - cursor).Magnitude
		if cursorDist > AIM.fov then continue end
		local score = AIM.priority == "Distance" and worldDist or cursorDist
		if (not bestScore or score < bestScore) and (not AIM.wallCheck or isVisible(cam, part)) then
			best, bestPart, bestRoot, bestHum, bestScore = player, part, root, hum, score
		end
	end
	return best, bestPart, bestRoot, bestHum
end

-- Who the next shot goes to. Always: whoever is nearest the cursor inside the circle. Hold and
-- Toggle: the circle only picks who to grab, then the lock stays on them until it's let go.
local function currentTarget(wantHead)
	if not AIM.enabled then return nil end
	if AIM.mode == "Always" then return pickTarget(wantHead) end
	if not lockHeld then return nil end
	if lockedPlayer then
		local part, root, hum = aimPartOf(lockedPlayer, wantHead)
		if part and (part.Position - myPosition()).Magnitude <= AIM.maxDistance then
			return lockedPlayer, part, root, hum
		end
		lockedPlayer = nil
	end
	local player, part, root, hum = pickTarget(wantHead)
	lockedPlayer = player
	return player, part, root, hum
end

-- How much of their current speed they've held, in a straight line, over the last half second:
-- 1 for a steady run, near 0 for strafing back and forth, stopping, or a run that only just began.
local function steadiness(player, speed)
	local tr = tracks[player]
	if not tr or #tr < 2 or speed < 1 then return 0 end
	local a, b = tr[1], tr[#tr]
	local span = b[1] - a[1]
	if span < 0.1 then return 0 end
	local moved = Vector3.new(b[2].X - a[2].X, 0, b[2].Z - a[2].Z).Magnitude
	return math.clamp(moved / (speed * span), 0, 1)
end

-- Where `part` will be `t` seconds from now. Across the ground: their run velocity, carried in full
-- for a steady run and fading out for strafing. Up and down: level unless they're rising or
-- falling, then a jump arc under workspace gravity that lands on the ground under their feet.
local function predictor(player, part, root, hum)
	local start = part.Position
	if not AIM.lead then
		return function() return start end
	end
	local vel = root.AssemblyLinearVelocity
	local flat = Vector3.new(vel.X, 0, vel.Z)
	local s = steadiness(player, flat.Magnitude)
	local tau = LEAD_TAU_MIN + (LEAD_TAU_MAX - LEAD_TAU_MIN) * s * s
	local gravity = workspace.Gravity

	local airborne = math.abs(vel.Y) > 2
	local lowest = -math.huge
	if airborne then
		groundParams.FilterDescendantsInstances = { root.Parent, workspace.CurrentCamera, LocalPlayer.Character }
		local ground = workspace:Blockcast(CFrame.new(root.Position), FOOTPRINT, Vector3.new(0, -GROUND_PROBE, 0), groundParams)
		if ground then
			local standHeight = hum.RigType == Enum.HumanoidRigType.R15 and hum.HipHeight + root.Size.Y / 2 or 3
			lowest = math.min(ground.Position.Y + standHeight + (start.Y - root.Position.Y), start.Y)
		end
	end

	return function(t)
		local p = start + flat * (tau * (1 - math.exp(-t / tau)))
		if not airborne then return p end
		return Vector3.new(p.X, math.max(start.Y + vel.Y * t - 0.5 * gravity * t * t, lowest), p.Z)
	end
end

-- whether the arc reaches the aim point without clipping a block on the way
local function arcIsClear(origin, velocity, gravity, flight, targetChar)
	arcParams.FilterDescendantsInstances = { targetChar, workspace.CurrentCamera, LocalPlayer.Character }
	local prev = origin
	for i = 1, ARC_CHECKS do
		local t = flight * i / ARC_CHECKS
		local p = origin + velocity * t + Vector3.new(0, -0.5 * gravity * t * t, 0)
		if workspace:Raycast(prev, p - prev, arcParams) then return false end
		prev = p
	end
	return true
end

-- Direction that makes a shot fired from `origin` at `speed` (falling at `gravity`) meet predict(t).
-- Walks time forward until the shot can cover the distance, then bisects inside that step.
local function solveIntercept(origin, speed, gravity, predict, maxTime)
	local function gap(t)
		-- Aiming this far above the target cancels the drop the shot picks up by time t.
		local aim = predict(t) - origin + Vector3.new(0, 0.5 * gravity * t * t, 0)
		return aim.Magnitude - speed * t, aim
	end

	local lo, t = 0, SOLVE_STEP
	while t <= maxTime do
		if gap(t) <= 0 then
			local hi = t
			for _ = 1, 20 do
				local mid = (lo + hi) / 2
				if gap(mid) > 0 then
					lo = mid
				else
					hi = mid
				end
			end
			local _, aim = gap(hi)
			return aim.Unit, hi
		end
		lo = t
		t += SOLVE_STEP
	end
	return nil
end

local function redirect(handler, launch, isPreview)
	local projectile = handler.projectile
	if type(projectile) ~= "string" or projectile:lower():find("turret") then
		return -- turrets pick their own targets
	end
	if AIM.skipPearls and projectile == "telepearl" then return end
	local from = launch.positionFrom
	local speed = launch.initialVelocity.Magnitude
	if not from or speed < 1 then return end

	local player, part, root, hum = currentTarget(wantsHead(projectile))
	if not player then return end

	local meta = handler:getProjectileMeta()
	local lifetime = meta and meta.lifetimeSec or 3
	local gravity = launch.gravitationalAcceleration or 0

	-- The chosen part first, then the other one: when a wall covers the body the head is often
	-- still in the open, and the other way round.
	local char = root.Parent
	local head = char:FindFirstChild("Head")
	local candidates = { part }
	if part ~= root then
		candidates[2] = root
	elseif head then
		candidates[2] = head
	end

	local shots = {}
	for _, aimPart in ipairs(candidates) do
		local predict = predictor(player, aimPart, root, hum)
		-- Solve from positionFrom, move the origin to where that direction really spawns the model, solve again.
		local dir, flight, spawn = (aimPart.Position - from).Unit, nil, nil
		for _ = 1, 2 do
			spawn = (CFrame.lookAt(from, from + dir) * SPAWN_OFFSET).Position
			dir, flight = solveIntercept(spawn, speed, gravity, predict, lifetime)
			if not dir then break end
		end
		if dir then
			shots[#shots + 1] = {
				dir = dir, flight = flight, spawn = spawn, part = aimPart,
				clear = arcIsClear(spawn, dir * speed, gravity, flight, char),
				farHead = aimPart == head and AIM.part == "Auto" and flight > HEADSHOT_MAX_FLIGHT,
			}
		end
	end

	-- first choice: a clear arc that isn't a long-range headshot; then any clear arc; then the
	-- chosen part anyway, since a thin fence or a stuck arrow can read as cover
	local pick
	for _, shot in ipairs(shots) do
		if shot.clear and not shot.farHead then pick = shot break end
	end
	if not pick then
		for _, shot in ipairs(shots) do
			if shot.clear then pick = shot break end
		end
	end
	pick = pick or shots[1]
	if not pick then
		if not isPreview then State.outOfReach += 1 end
		return -- out of range, leave the shot alone
	end
	launch.initialVelocity = pick.dir * speed

	if not isPreview then
		State.shots += 1
		State.lastShot = string.format("%s %d sps → %s · %.2fs%s", projectile, math.floor(speed + 0.5),
			player.DisplayName, pick.flight, pick.part == head and " · head" or "")
		State.lastLaunch = {
			at = os.clock(), origin = pick.spawn, velocity = launch.initialVelocity, gravity = gravity,
			flight = pick.flight, target = player, part = pick.part.Name, clear = pick.clear,
		}
	end
end

local function hooked(self, handler, isPreview, ...)
	local launch = original(self, handler, isPreview, ...)
	-- State.running guards a copy that outlived its unload (something else hooked on top of it)
	if State.running and AIM.enabled and launch and handler then
		local ok, err = pcall(redirect, handler, launch, isPreview)
		if not ok then State.lastError = tostring(err) end
	end
	return launch
end
if HOOKABLE then Class.calculateImportantLaunchValues = hooked end

local function aimStep()
	local cursor = UserInputService:GetMouseLocation()
	fovCircle.Position = cursor
	fovCircle.Radius = AIM.fov
	fovCircle.Visible = AIM.enabled and AIM.showFov

	local player, part = currentTarget(wantsHead(heldItemName()))
	if player and player ~= lastLocked then State.locks += 1 end
	lastLocked = player or lastLocked
	State.target = player

	local cam = workspace.CurrentCamera
	if part and cam then
		local screen = cam:WorldToViewportPoint(part.Position)
		aimDot.Position = Vector2.new(screen.X, screen.Y)
		aimDot.Visible = AIM.showMarker and screen.Z > 0
		fovCircle.Color = FOV_LOCKED
	else
		aimDot.Visible = false
		fovCircle.Color = FOV_IDLE
	end
end

-- right after the default camera script, so the circle and marker line up with this frame's view
local AIM_BIND = randomName()
RunService:BindToRenderStep(AIM_BIND, Enum.RenderPriority.Camera.Value + 1, aimStep)
conns[#conns + 1] = RunService.Heartbeat:Connect(trackPlayers)

