local function b64decode(s)
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local map = {}
	for i = 1, 64 do map[string.byte(alphabet, i)] = i - 1 end
	local out = buffer.create(#s * 3 // 4)
	local n, acc, bits = 0, 0, 0
	for i = 1, #s do
		local v = map[string.byte(s, i)]
		if v then
			acc = bit32.bor(bit32.lshift(acc, 6), v)
			bits += 6
			if bits >= 8 then
				bits -= 8
				buffer.writeu8(out, n, bit32.band(bit32.rshift(acc, bits), 255))
				n += 1
			end
		end
	end
	return buffer.readstring(out, 0, n)
end

local function writeAsset(ic)
	return (pcall(function()
		if isfile and readfile and isfile(ic.file) and #readfile(ic.file) == ic.bytes then return end
		writefile(ic.file, b64decode(ic.b64))
	end))
end

if writefile and getcustomasset then
	for _, ic in ipairs(ICONS) do
		if writeAsset(ic) then table.insert(SHADEEDWARE_ICONS, ic.file) end
	end
	for _, v in ipairs(VIDEOS) do
		local sheets, ok = {}, writeAsset(v.audio)
		for _, s in ipairs(v.sheets) do
			ok = writeAsset(s) and ok
			table.insert(sheets, s.file)
		end
		if ok then
			table.insert(SHADEEDWARE_VIDEOS, {
				frames = v.frames, fps = v.fps, w = v.w, h = v.h, cols = v.cols, rows = v.rows,
				audio = v.audio.file, sheets = sheets,
			})
		end
	end
	for _, r in ipairs(REMOTE.images) do
		if writeAsset(r) then table.insert(SHADEEDWARE_REMOTE.images, r.file) end
	end
	for _, a in ipairs(REMOTE.anims) do
		local sheets, ok = {}, true
		for _, s in ipairs(a.sheets) do
			ok = writeAsset(s) and ok
			table.insert(sheets, s.file)
		end
		if ok then
			table.insert(SHADEEDWARE_REMOTE.anims, {
				id = a.id, frames = a.frames, fps = a.fps, w = a.w, h = a.h,
				cols = a.cols, rows = a.rows, sheets = sheets,
			})
		end
	end
	-- lets a hub run on its own, without this loader, still find everything written above, and
	-- tells the controller what there is to send
	pcall(function()
		writefile("shadeed_manifest.json", game:GetService("HttpService"):JSONEncode({
			icons = SHADEEDWARE_ICONS, videos = SHADEEDWARE_VIDEOS, remote = SHADEEDWARE_REMOTE,
		}))
	end)
end

