----------------------------------------------------------------------
-- behaviour engine: randomness, fatigue, breaks, rate ceiling
----------------------------------------------------------------------
local rng = Random.new()

local function chance(p)
	return rng:NextNumber() < p
end

local function gauss(mean, sd, lo, hi)
	local u1 = math.max(rng:NextNumber(), 1e-9)
	local u2 = rng:NextNumber()
	local z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
	local v = mean + z * sd
	if lo then v = math.max(v, lo) end
	if hi then v = math.min(v, hi) end
	return v
end

local Behavior = {
	sessionStart = os.clock(),
	lastBreakEnd = os.clock(),
	pauseUntil = 0,
	breaksTaken = 0,
	breakReason = "",
	catchStamps = {},
	sinceBreak = 0,
	breakAt = 0,
	castTotal = 0,
	castPerfect = 0,
	catchTotal = 0,
	catchPerfect = 0,
}

Behavior.breakAt = math.floor(gauss(CFG.breakEveryCatches, CFG.breakEveryCatches * 0.3, 8, 200) + 0.5)

-- reaction times get slower the longer you go without a break, plus a slow wander.
-- a bot whose 400th click is as sharp as its first is the easiest thing in the world to spot.
function Behavior.focus()
	local since = os.clock() - Behavior.lastBreakEnd
	local fatigue = math.min(0.32, since / 2400 * 0.32)
	local wander = 0.06 * math.sin(os.clock() / 47) + 0.04 * math.sin(os.clock() / 13.3)
	return 1 + fatigue + wander
end

function Behavior.reaction(mean, sd, lo, hi)
	local f = Behavior.focus()
	return gauss(mean * f, sd * f, lo, hi and hi * f or nil)
end

function Behavior.isPaused()
	return os.clock() < Behavior.pauseUntil
end

function Behavior.pauseFor(seconds, reason)
	Behavior.pauseUntil = math.max(Behavior.pauseUntil, os.clock() + seconds)
	Behavior.breakReason = reason or ""
end

function Behavior.startBreak()
	Behavior.breaksTaken += 1
	local long = Behavior.breaksTaken % 5 == 0
	local d = long and gauss(300, 95, 150, 620) or gauss(48, 21, 18, 145)
	Behavior.pauseFor(d, long and "long break" or "break")
	Behavior.sinceBreak = 0
	Behavior.breakAt = math.floor(gauss(CFG.breakEveryCatches, CFG.breakEveryCatches * 0.3, 8, 200) + 0.5)
	task.delay(d, function() Behavior.lastBreakEnd = os.clock() end)
	return d, long
end

function Behavior.catchesThisHour()
	local now = os.clock()
	local n = 0
	for i = #Behavior.catchStamps, 1, -1 do
		if now - Behavior.catchStamps[i] > 3600 then
			table.remove(Behavior.catchStamps, i)
		else
			n += 1
		end
	end
	return n
end

function Behavior.registerCatch(perfect)
	table.insert(Behavior.catchStamps, os.clock())
	Behavior.catchTotal += 1
	Behavior.sinceBreak += 1
	if perfect then Behavior.catchPerfect += 1 end
end

-- returns nil when clear to cast, or a string reason to hold
function Behavior.castBlocker()
	if Behavior.isPaused() then
		return string.format("%s · %ds left", Behavior.breakReason, math.ceil(Behavior.pauseUntil - os.clock()))
	end
	if Behavior.sinceBreak >= Behavior.breakAt then
		local d, long = Behavior.startBreak()
		return string.format("%s · %ds", long and "long break" or "break", math.ceil(d))
	end
	if Behavior.catchesThisHour() >= CFG.catchesPerHour then
		Behavior.pauseFor(gauss(70, 25, 25, 180), "hourly cap")
		return "hourly cap reached"
	end
	return nil
end

