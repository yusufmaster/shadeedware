----------------------------------------------------------------------
-- executor shims
----------------------------------------------------------------------
local function glob(name)
	local ok, v = pcall(function()
		return (getfenv and getfenv(1) or _G)[name]
	end)
	if ok and v ~= nil then return v end
	ok, v = pcall(function() return _G[name] end)
	if ok and v ~= nil then return v end
	return nil
end

local syn = glob("syn")
local gethui = glob("gethui") or glob("get_hidden_gui")

-- Run this file directly instead of through the loader and SHADEEDWARE_ICONS never gets set,
-- which would leave you with the one fallback picture and no clips -- and the rotation saved
-- below would shrink to match, wiping the queue for the next proper run too. The loader leaves a
-- manifest of everything it wrote, so a direct run shows the same gallery the loader does.
if not (type(SHADEEDWARE_ICONS) == "table" and #SHADEEDWARE_ICONS > 0) then
	local rf, isf = glob("readfile"), glob("isfile")
	local ok, manifest = pcall(function()
		return game:GetService("HttpService"):JSONDecode(rf("shadeed_manifest.json"))
	end)
	if ok and type(manifest) == "table" then
		local function present(f)
			if not isf then return true end
			local okc, r = pcall(isf, f)
			return okc and r == true
		end
		local icons, vids = {}, {}
		for _, f in ipairs(type(manifest.icons) == "table" and manifest.icons or {}) do
			if type(f) == "string" and present(f) then table.insert(icons, f) end
		end
		for _, v in ipairs(type(manifest.videos) == "table" and manifest.videos or {}) do
			if type(v) == "table" and type(v.audio) == "string" and type(v.sheets) == "table" and present(v.audio) then
				table.insert(vids, v)
			end
		end
		if #icons > 0 then ICON_POOL, ICON_FILE = icons, icons[1] end
		if #vids > 0 then VIDEO_POOL = vids end
		local remote = type(manifest.remote) == "table" and manifest.remote or {}
		local ri, ra = {}, {}
		for _, f in ipairs(type(remote.images) == "table" and remote.images or {}) do
			if type(f) == "string" and present(f) then table.insert(ri, f) end
		end
		for _, a in ipairs(type(remote.anims) == "table" and remote.anims or {}) do
			if type(a) == "table" and type(a.id) == "string" and type(a.sheets) == "table"
				and type(a.sheets[1]) == "string" and present(a.sheets[1]) then
				table.insert(ra, a)
			end
		end
		if #ri + #ra > 0 then REMOTE_POOL = { images = ri, anims = ra } end
	end
end

-- Pictures and clips go through a shuffled cycle saved in the workspace, so nothing repeats
-- until everything has had a turn, re-executes included.
local CYCLE_FILE = "shadeed_cycle.json"

local function shuffled(list)
	local out = table.clone(list)
	for i = #out, 2, -1 do
		local j = ICON_RNG:NextInteger(1, i)
		out[i], out[j] = out[j], out[i]
	end
	return out
end

local function nextInCycle(key, valid, build)
	local HttpService = game:GetService("HttpService")
	local rf, wf = glob("readfile"), glob("writefile")
	local state = {}
	local okR, decoded = pcall(function() return HttpService:JSONDecode(rf(CYCLE_FILE)) end)
	if okR and type(decoded) == "table" then state = decoded end

	-- drop anything that's no longer bundled (the gallery changed since the file was saved)
	local queue = {}
	if type(state[key]) == "table" then
		for _, item in ipairs(state[key]) do
			if valid[item] then table.insert(queue, item) end
		end
	end
	if #queue == 0 then
		queue = build()
		-- don't let a fresh cycle open with whatever closed the last one
		if #queue > 1 and queue[1] == state[key .. "Last"] then
			queue[1], queue[2] = queue[2], queue[1]
		end
	end

	local item = table.remove(queue, 1)
	state[key], state[key .. "Last"] = queue, item
	if wf then pcall(function() wf(CYCLE_FILE, HttpService:JSONEncode(state)) end) end
	return item
end

do
	local valid = {}
	for _, f in ipairs(ICON_POOL) do valid[f] = true end
	ICON_FILE = nextInCycle("icon", valid, function() return shuffled(ICON_POOL) end) or ICON_FILE
end
