		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
	})
	if desc then
		new("TextLabel", {
			Parent = r, Size = UDim2.new(1, -60, 0, 14), Position = UDim2.fromOffset(0, 28),
			BackgroundTransparency = 1, Text = desc, TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.muted,
		})
	end

	local sw = new("TextButton", {
		Parent = r, Size = UDim2.fromOffset(40, 22),
		Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = T.panel2, AutoButtonColor = false, Text = "",
	}, { circle(), stroke(T.stroke, 1, 0.3) })

	local knob = new("Frame", {
		Parent = sw, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = T.muted,
	}, { circle() })

	local on = default and true or false
	local function render(animate)
		local t = animate and 0.18 or 0
		tween(sw, t, { BackgroundColor3 = on and T.accent or T.panel2 })
		tween(knob, t, {
			Position = UDim2.fromOffset(on and 21 or 3, 3),
			BackgroundColor3 = on and Color3.fromRGB(10, 20, 22) or T.muted,
		})
	end
	render(false)

	sw.MouseButton1Click:Connect(function()
		on = not on
		render(true)
		task.spawn(cb, on)
		pcall(easterEgg)
	end)

	return function(v)
		if v ~= nil and v ~= on then
			on = v and true or false
			render(true)
			task.spawn(cb, on)
		end
		return on
	end
end

local function slider(page, order, title, min, max, default, suffix, cb)
	local r = row(page, order, 60)

	new("TextLabel", {
		Parent = r, Size = UDim2.new(1, -70, 0, 16), Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1, Text = title, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
	})
	local valLbl = new("TextLabel", {
		Parent = r, Size = UDim2.fromOffset(64, 20),
		Position = UDim2.new(1, 0, 0, 10), AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = T.panel2, Text = tostring(default) .. (suffix or ""),
		Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = T.accent,
	}, { corner(6) })

	local bar = new("Frame", {
		Parent = r, Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromOffset(0, 40),
		BackgroundColor3 = T.panel2,
	}, { corner(3) })
	local prog = new("Frame", {
		Parent = bar, BackgroundColor3 = T.accent,
		Size = UDim2.fromScale((default - min) / (max - min), 1),
	}, { corner(3), new("UIGradient", { Color = ColorSequence.new(T.accent2, T.accent) }) })
	local knob = new("Frame", {
		Parent = bar, Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.text,
	}, { circle(), stroke(T.bg, 2, 0) })

	local hit = new("TextButton", {
		Parent = r, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 31),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	})

	local value = default
	local dragging = false

	local function label(v)
		return ((max - min) <= 10 and string.format("%.2f", v) or tostring(math.floor(v + 0.5))) .. (suffix or "")
	end
	valLbl.Text = label(default)

	local function set(v, fire)
		value = math.clamp(v, min, max)
		local a = (value - min) / (max - min)
		prog.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valLbl.Text = label(value)
		if fire then task.spawn(cb, value) end
	end

	local function fromX(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		set(min + a * (max - min), true)
	end

	hit.MouseButton1Down:Connect(function()
		dragging = true
		tween(knob, 0.12, { Size = UDim2.fromOffset(18, 18) })
		fromX(UserInputService:GetMouseLocation().X)
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				tween(knob, 0.12, { Size = UDim2.fromOffset(14, 14) })
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(UserInputService:GetMouseLocation().X)
		end
	end)

	return set, valLbl
end

