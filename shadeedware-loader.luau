conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input, gp)
	-- Keyboard presses swallowed by the game (chat) don't count. Mouse buttons always count for
	-- the aim key, since HUD frames covering the screen would otherwise eat right click.
	if matchesKey(input, AIM.key) and not (gp and input.UserInputType == Enum.UserInputType.Keyboard) then
		if AIM.hold then
			aiming = true
		else
			aiming = not aiming
		end
	end
	-- a left click on the hub or a HUD button isn't a swing
	if input.UserInputType == Enum.UserInputType.MouseButton1 and not gp then
		meleeHeld = true
	end
	if not gp and matchesKey(input, NOCLIP.key) then
		setNoclip(not NOCLIP.on)
	end
	if not gp and matchesKey(input, DESYNC.markKey) then markDesyncSpot() end
	if not gp and matchesKey(input, DESYNC.holdKey) then startDesync() end
	if not gp and matchesKey(input, GOD.key) then setGod(not GOD.on) end
end)
conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
	if AIM.hold and matchesKey(input, AIM.key) then aiming = false end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then meleeHeld = false end
	if matchesKey(input, DESYNC.holdKey) then stopDesync() end
end)

