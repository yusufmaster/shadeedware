-- click, then press a key: rebinds to a keyboard key or a mouse button (Esc cancels)
local KEY_NAMES = {
	[Enum.UserInputType.MouseButton1] = "Left click",
	[Enum.UserInputType.MouseButton2] = "Right click",
	[Enum.UserInputType.MouseButton3] = "Middle click",
}
local function keyName(k)
	return KEY_NAMES[k] or k.Name
end

local function matchesKey(input, key)
	if key.EnumType == Enum.KeyCode then
		return input.KeyCode == key
	end
	return input.UserInputType == key
end

local function keybind(page, order, title, default, cb)
	local r = row(page, order, 42)
	new("TextLabel", {
		Parent = r, Size = UDim2.new(1, -130, 1, 0),
		BackgroundTransparency = 1, Text = title, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
	})
	local b = new("TextButton", {
		Parent = r, Size = UDim2.fromOffset(116, 24),
		Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = T.panel2, AutoButtonColor = false,
		Text = keyName(default), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = T.accent,
	}, { corner(7), stroke(T.stroke, 1, 0.3) })

	local current, listening = default, false
	b.MouseButton1Click:Connect(function()
		listening = true
		b.Text = "press a key…"
		b.TextColor3 = T.muted
	end)
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(i, gp)
		if not listening then return end
		local t, pick = i.UserInputType, nil
		if t == Enum.UserInputType.Keyboard then
			if i.KeyCode ~= Enum.KeyCode.Escape then pick = i.KeyCode end
		elseif t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
			pick = t
		elseif t == Enum.UserInputType.MouseButton1 and not gp then
			-- left click out in the world binds it; a click on another button in the ui doesn't
			pick = t
		else
			return
		end
		listening = false
		if pick then
			current = pick
			task.spawn(cb, pick)
		end
		b.Text = keyName(current)
		b.TextColor3 = T.accent
	end)
end

----------------------------------------------------------------------
-- drawing helpers
----------------------------------------------------------------------
-- Without a Drawing API the 2D pieces become inert stand-ins, so chams and the aimlock itself
-- still work.
local function newDrawing(class, props)
	if not Drawing then
		return setmetatable({}, { __index = function() return function() end end })
	end
	local d = Drawing.new(class)
	for k, v in pairs(props) do
		d[k] = v
	end
	d.Visible = false
	return d
end

local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local HP_LOW = Color3.fromRGB(255, 60, 60)
local HP_FULL = Color3.fromRGB(60, 255, 90)
local FONT = Drawing and Drawing.Fonts and Drawing.Fonts.Plex or 2

-- Character parts live in the game's own collision groups (Player / Players / Uncollidable), and a
-- ray in the Default group passes straight through some of them. The game's guns cast in the
-- "Raycasts" group, which hits bodies and walls the way a bullet should; every ray here uses it.
local RAY_GROUP = "Default"
pcall(function()
	if game:GetService("PhysicsService"):IsCollisionGroupRegistered("Raycasts") then RAY_GROUP = "Raycasts" end
end)

-- one line-of-sight query shared by ESP and aimlock; both refresh the filter each frame
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude
losParams.IgnoreWater = true
losParams.CollisionGroup = RAY_GROUP

local function hasLineOfSight(camPos, part, char)
	local hit = workspace:Raycast(camPos, part.Position - camPos, losParams)
	return not hit or hit.Instance:IsDescendantOf(char)
end

local function isTeammate(player)
	return player.Team ~= nil and player.Team == LocalPlayer.Team
end

----------------------------------------------------------------------
-- ESP
----------------------------------------------------------------------
local R15_BONES = {
	{ "Head", "UpperTorso" },
	{ "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" },
	{ "LeftUpperArm", "LeftLowerArm" },
	{ "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" },
	{ "RightUpperArm", "RightLowerArm" },
	{ "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" },
	{ "LeftUpperLeg", "LeftLowerLeg" },
	{ "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" },
	{ "RightUpperLeg", "RightLowerLeg" },
	{ "RightLowerLeg", "RightFoot" },
}
-- R6 limbs are single parts: each becomes joint-to-top plus top-to-bottom. true = hangs off the
-- neck (arms), false = off the pelvis (legs).
local R6_LIMBS = {
	{ "Left Arm", true },
	{ "Right Arm", true },
	{ "Left Leg", false },
	{ "Right Leg", false },
}
local MAX_BONES = #R15_BONES
local FLAT = { "boxOutline", "box", "name", "dist", "hpOutline", "hp", "tracer" }

local espEntries = {}
local segA, segB = table.create(MAX_BONES), table.create(MAX_BONES)

local function newEntry()
	local e = {
		boxOutline = newDrawing("Square", { Filled = false, Color = BLACK, ZIndex = 1 }),
		box = newDrawing("Square", { Filled = false, ZIndex = 2 }),
		name = newDrawing("Text", { Center = true, Outline = true, OutlineColor = BLACK, Color = WHITE, Font = FONT, ZIndex = 3 }),
		dist = newDrawing("Text", {
			Center = true, Outline = true, OutlineColor = BLACK,
			Color = Color3.fromRGB(205, 205, 205), Font = FONT, ZIndex = 3,
		}),
		hpOutline = newDrawing("Square", { Filled = true, Color = BLACK, ZIndex = 1 }),
		hp = newDrawing("Square", { Filled = true, ZIndex = 2 }),
		tracer = newDrawing("Line", { ZIndex = 1 }),
		bones = table.create(MAX_BONES),
		hl = Instance.new("Highlight"),
	}
	for i = 1, MAX_BONES do
		e.bones[i] = newDrawing("Line", { ZIndex = 2 })
	end
	e.hl.Name = randomName()
	e.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	e.hl.OutlineTransparency = 0
	e.hl.Enabled = false
	e.hl.Parent = espFolder
	return e
end

local function hide2D(e)
	for _, key in ipairs(FLAT) do
		e[key].Visible = false
	end
	for _, line in ipairs(e.bones) do
		line.Visible = false
	end
end

local function hideEntry(e)
	hide2D(e)
	e.hl.Enabled = false
end

local function destroyEntry(e)
	for _, key in ipairs(FLAT) do
		pcall(function() e[key]:Remove() end)
	end
	for _, line in ipairs(e.bones) do
		pcall(function() line:Remove() end)
	end
	e.hl:Destroy()
end

-- fills segA/segB with world-space bone endpoints, returns how many there are
local function collectBones(char, rig)
	local n = 0
	if rig == Enum.HumanoidRigType.R15 then
		for _, pair in ipairs(R15_BONES) do
			local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
			if a and b then
				n += 1
				segA[n], segB[n] = a.Position, b.Position
			end
		end
		return n
	end

	local torso = char:FindFirstChild("Torso")
	if not torso then return 0 end
	local cf = torso.CFrame
	local neck, pelvis = cf * Vector3.new(0, 1, 0), cf * Vector3.new(0, -1, 0)
	local head = char:FindFirstChild("Head")
	if head then
		n += 1
		segA[n], segB[n] = head.Position, neck
	end
	n += 1
	segA[n], segB[n] = neck, pelvis
	for _, limb in ipairs(R6_LIMBS) do
		local part = char:FindFirstChild(limb[1])
		if part then
			local half = part.CFrame.UpVector * (part.Size.Y / 2)
			local top = part.Position + half
			n += 1
			segA[n], segB[n] = limb[2] and neck or pelvis, top
			n += 1
			segA[n], segB[n] = top, part.Position - half
		end
	end
	return n
end

-- false = don't draw this player at all (dead, teammate, too far)
local function renderEntry(player, e, cam, camPos, origin, tracerFrom)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) or hum.Health <= 0 then return false end
	if ESP.teamCheck and isTeammate(player) then return false end
	local dist = (hrp.Position - origin).Magnitude
	if dist > ESP.maxDistance then return false end

	local head = char:FindFirstChild("Head")
	local color = ESP.color
	if ESP.visibleCheck and hasLineOfSight(camPos, head or hrp, char) then
		color = ESP.visibleColor
	end

	-- chams are 3D, so they stay on even when the box would land off screen
	local hl = e.hl
	if ESP.chams then
		if hl.Adornee ~= char then hl.Adornee = char end
		if hl.FillColor ~= color then
			hl.FillColor = color
			hl.OutlineColor = color
		end
		if hl.FillTransparency ~= ESP.chamsFill then hl.FillTransparency = ESP.chamsFill end
		hl.Enabled = true
	else
		hl.Enabled = false
	end

	-- Box runs from the top of the head to the floor. R15 HipHeight is the gap from the HRP's
	-- bottom to the ground; R6 legs are a fixed 2 studs under the HRP.
	local legs = hum.RigType == Enum.HumanoidRigType.R15 and hum.HipHeight or 2
	local topWorld = head and head.Position + Vector3.new(0, head.Size.Y / 2 + 0.25, 0)
		or hrp.Position + Vector3.new(0, 3, 0)
	local bottomWorld = hrp.Position - Vector3.new(0, hrp.Size.Y / 2 + legs, 0)
	local top = cam:WorldToViewportPoint(topWorld)
	local bottom = cam:WorldToViewportPoint(bottomWorld)
	if top.Z <= 0 or bottom.Z <= 0 then
		hide2D(e)
		return true
	end

	local h = math.max(bottom.Y - top.Y, 6)
	local w = h * 0.55
	local cx = (top.X + bottom.X) / 2
	local x, y = math.floor(cx - w / 2), math.floor(top.Y)
	w, h = math.floor(w), math.floor(h)
	local thick = ESP.thickness

	e.box.Visible, e.boxOutline.Visible = ESP.boxes, ESP.boxes
	if ESP.boxes then
		local pos, size = Vector2.new(x, y), Vector2.new(w, h)
		e.box.Position, e.box.Size, e.box.Color, e.box.Thickness = pos, size, color, thick
		e.boxOutline.Position, e.boxOutline.Size, e.boxOutline.Thickness = pos, size, thick + 2
	end

	e.name.Visible = ESP.names
	if ESP.names then
		e.name.Text = player.DisplayName
		e.name.Size = ESP.textSize
		e.name.Position = Vector2.new(cx, y - ESP.textSize - 2)
	end

	e.dist.Visible = ESP.distance
	if ESP.distance then
		e.dist.Text = math.floor(dist) .. " studs"
		e.dist.Size = ESP.textSize - 1
		e.dist.Position = Vector2.new(cx, y + h + 2)
	end

	e.hp.Visible, e.hpOutline.Visible = ESP.healthBars, ESP.healthBars
	if ESP.healthBars then
		local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		local hpFill = math.floor(h * frac)
		e.hpOutline.Position, e.hpOutline.Size = Vector2.new(x - 6, y - 1), Vector2.new(4, h + 2)
		e.hp.Position, e.hp.Size = Vector2.new(x - 5, y + h - hpFill), Vector2.new(2, hpFill)
		e.hp.Color = HP_LOW:Lerp(HP_FULL, frac)
	end

	e.tracer.Visible = ESP.tracers
	if ESP.tracers then
		e.tracer.From, e.tracer.To = tracerFrom, Vector2.new(cx, y + h)
		e.tracer.Color, e.tracer.Thickness = color, thick
	end

	local used = 0
	if ESP.skeleton then
		for i = 1, collectBones(char, hum.RigType) do
			local a = cam:WorldToViewportPoint(segA[i])
			local b = cam:WorldToViewportPoint(segB[i])
			if a.Z > 0 and b.Z > 0 then
				used += 1
				local line = e.bones[used]
				line.From, line.To = Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y)
				line.Color, line.Thickness = color, thick
				line.Visible = true
			end
		end
	end
	for i = used + 1, MAX_BONES do
		e.bones[i].Visible = false
	end

	return true
end

local function espStep()
	local cam = workspace.CurrentCamera
	if not ESP.enabled or not cam then
		for _, e in pairs(espEntries) do hideEntry(e) end
		return
	end

	local camPos = cam.CFrame.Position
	local vp = cam.ViewportSize
	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local origin = myRoot and myRoot.Position or camPos
	losParams.FilterDescendantsInstances = { cam, myChar }

	local tracerFrom
	if ESP.tracerOrigin == "Mouse" then
		tracerFrom = UserInputService:GetMouseLocation()
	elseif ESP.tracerOrigin == "Center" then
		tracerFrom = vp / 2
	else
		tracerFrom = Vector2.new(vp.X / 2, vp.Y)
	end

	for player, e in pairs(espEntries) do
		if not renderEntry(player, e, cam, camPos, origin, tracerFrom) then
			hideEntry(e)
		end
	end
end

local function addPlayer(player)
	if player ~= LocalPlayer and not espEntries[player] then
		espEntries[player] = newEntry()
	end
end

local function removePlayer(player)
	local e = espEntries[player]
	if e then
		espEntries[player] = nil
		destroyEntry(e)
	end
end

for _, player in ipairs(Players:GetPlayers()) do addPlayer(player) end
conns[#conns + 1] = Players.PlayerAdded:Connect(addPlayer)
conns[#conns + 1] = Players.PlayerRemoving:Connect(removePlayer)

----------------------------------------------------------------------
-- aimlock
----------------------------------------------------------------------
local FOV_IDLE = Color3.fromRGB(255, 255, 255)
local FOV_LOCKED = Color3.fromRGB(80, 255, 120)

local fovCircle = newDrawing("Circle", { Thickness = 1, NumSides = 64, Filled = false, Color = FOV_IDLE })
local aimDot = newDrawing("Circle", { Radius = 4, NumSides = 16, Filled = true, Color = FOV_LOCKED })
local aiming = false

-- the part to aim at plus its character, or nil when the player isn't a valid target
local function aimPartOf(player)
	if not player or not player.Parent then return nil end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	if AIM.teamCheck and isTeammate(player) then return nil end
	local part = char:FindFirstChild(AIM.part) or char:FindFirstChild("HumanoidRootPart")
	if not part then return nil end
	return part, char
end

local function pickTarget(cam, cursor, origin)
	local camPos = cam.CFrame.Position
	local best, bestScore = nil, math.huge
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local part, char = aimPartOf(player)
		if not part then continue end
		local worldDist = (part.Position - origin).Magnitude
		if worldDist > AIM.maxDistance then continue end
		local screen = cam:WorldToViewportPoint(part.Position)
		if screen.Z <= 0 then continue end
		local cursorDist = (Vector2.new(screen.X, screen.Y) - cursor).Magnitude
		if cursorDist > AIM.fov then continue end
		local score = AIM.priority == "Distance" and worldDist or cursorDist
		if score < bestScore and (not AIM.wallCheck or hasLineOfSight(camPos, part, char)) then
			best, bestScore = player, score
		end
	end
	return best
end

local function releaseAim()
	State.target = nil
	fovCircle.Color = FOV_IDLE
	aimDot.Visible = false
end

local function aimStep(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end

	local cursor = UserInputService:GetMouseLocation()
	fovCircle.Position = cursor
	fovCircle.Radius = AIM.fov
	fovCircle.Visible = AIM.enabled and AIM.showFov

	if not (AIM.enabled and aiming) then
		releaseAim()
		return
	end

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local origin = myRoot and myRoot.Position or cam.CFrame.Position
	losParams.FilterDescendantsInstances = { cam, myChar }

	local target = State.target
	local part = aimPartOf(target)
	local keep = AIM.sticky and part and (part.Position - origin).Magnitude <= AIM.maxDistance
	if not keep then
		target = pickTarget(cam, cursor, origin)
		part = aimPartOf(target)
	end
	if not part then
		releaseAim()
		return
	end
	if target ~= State.target then State.locks += 1 end
	State.target = target

	local aimPos = part.Position + part.AssemblyLinearVelocity * AIM.prediction
	-- exponential smoothing scaled by frame time, so the glide feels the same at any fps
	local smooth = math.clamp(AIM.smoothness, 0, 0.99)
	local alpha = smooth > 0 and 1 - smooth ^ (dt * 60) or 1

	if AIM.method == "Mouse" and mousemoverel then
		local screen = cam:WorldToViewportPoint(aimPos)
		if screen.Z > 0 then
			mousemoverel(math.round((screen.X - cursor.X) * alpha), math.round((screen.Y - cursor.Y) * alpha))
		end
	else
		local camCF = cam.CFrame
		cam.CFrame = camCF:Lerp(CFrame.lookAt(camCF.Position, aimPos), alpha)
	end

	local screen = cam:WorldToViewportPoint(aimPos)
	aimDot.Position = Vector2.new(screen.X, screen.Y)
	aimDot.Visible = screen.Z > 0
	fovCircle.Color = FOV_LOCKED
end

----------------------------------------------------------------------
-- melee fast attack
----------------------------------------------------------------------
local meleeHeld = false
local swingClock = 0

local function isMelee(tool)
	if not tool then return false end
	if MELEE.anyTool then return true end
	local lower = string.lower(tool.Name)
	for _, name in ipairs(MELEE.extraTools) do
		if lower == name then return true end
	end
	-- guns carry FIREBUTTON; their firing runs in the Client script, not off Activated
	if tool:GetAttribute("FIREBUTTON") then return false end
	local cfg = tool:FindFirstChild("Config")
	if cfg then
		for name in pairs(cfg:GetAttributes()) do
			if name:find("Swing") or name:find("^M1") then return true end
		end
	end
	return false
end

local function heldTool()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Tool")
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
	if not (MELEE.enabled and (MELEE.always or meleeHeld)) then
		swingClock = 0
		return
	end
	swingClock += dt
	if swingClock < 1 / MELEE.clicksPerSecond then return end
	swingClock = 0

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local tool = heldTool()
	if isMelee(tool) then
		-- a full click, press then release, so tools listening for Deactivated don't see a
		-- button stuck down
		tool:Activate()
		tool:Deactivate()
		State.clicksSent += 1
	end
end)

-- Swing meter. Melee here is server-driven, so the proof a swing happened is the server playing
-- the weapon's attack animation on our character. Counted: any animation start while a tool is
-- out, minus the Animate script's movement set and the tool's own idle / equip / run. One swing
-- can fire a few animations at once, so starts inside SWING_GAP of the last count are the same swing.
local SWING_GAP = 0.2
local swingTimes = {} -- os.clock() of each swing the server played, newest last
local lastTrackPos = {}
local ignoreCache = setmetatable({}, { __mode = "k" }) -- character / tool -> { [assetDigits] = true }
local NOT_ATTACKS = { "idle", "equip", "run", "walk", "hold", "sprint" }

local function assetDigits(anim)
	return anim and anim.AnimationId:match("%d+") or "?"
end

local function ignoredIds(inst, onlyNonAttacks)
	local ids = ignoreCache[inst]
	if ids then return ids end
	ids = {}
	for _, a in ipairs(inst:GetDescendants()) do
		if a:IsA("Animation") then
			local skip = not onlyNonAttacks
			if onlyNonAttacks then
				local lname = string.lower(a.Name)
				for _, word in ipairs(NOT_ATTACKS) do
					if lname:find(word) then skip = true break end
				end
			end
			if skip then ids[assetDigits(a)] = true end
		end
	end
	ignoreCache[inst] = ids
	return ids
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	local tool = char and char:FindFirstChildOfClass("Tool")
	if not animator or not tool then
		table.clear(lastTrackPos)
		return
	end
	local animate = char:FindFirstChild("Animate")
	local core = animate and ignoredIds(animate, false) or {}
	local toolSkip = ignoredIds(tool, true)

	local seen = {}
	for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
		seen[tr] = true
		local prev = lastTrackPos[tr]
		-- a new track, or one that jumped back to the start: the server just (re)played it
		if prev == nil or tr.TimePosition < prev - 0.05 then
			local id = assetDigits(tr.Animation)
			local lname = tr.Animation and string.lower(tr.Animation.Name) or ""
			local isMove = core[id] or toolSkip[id]
			for _, word in ipairs(NOT_ATTACKS) do
				if lname:find(word) then isMove = true break end
			end
			local now = os.clock()
			if not isMove and (#swingTimes == 0 or now - swingTimes[#swingTimes] > SWING_GAP) then
				table.insert(swingTimes, now)
				State.swingsLanded += 1
				if #swingTimes > 64 then table.remove(swingTimes, 1) end
			end
		end
		lastTrackPos[tr] = tr.TimePosition
	end
	for tr in pairs(lastTrackPos) do
		if not seen[tr] then lastTrackPos[tr] = nil end
	end
end)

local function swingsInLast(secs)
	local cutoff, n = os.clock() - secs, 0
	for i = #swingTimes, 1, -1 do
		if swingTimes[i] < cutoff then break end
		n += 1
	end
	return n
end

----------------------------------------------------------------------
-- walk speed
----------------------------------------------------------------------
-- The character's ClientCharacterSystem LocalScript rewrites Humanoid.WalkSpeed every Stepped
-- from Humanoid.WalkSpeedSet (plus SpeedBoostTags, x0.375 in HitStun, 0 while StopMoving).
-- Setting WalkSpeedSet feeds our speed through that same code, so stuns still land and nothing
-- fights over the property. When the game moves WalkSpeedSet itself, that becomes the value
-- restored on turning speed off.
local MOVE = { speedOn = false, speed = 28, infJump = false }
local speedSet, speedBase, speedWritten = nil, nil, nil

local function restoreSpeed()
	if speedSet and speedSet.Parent and speedBase then speedSet.Value = speedBase end
	speedWritten = nil
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local set = hum and hum:FindFirstChild("WalkSpeedSet")
	if set ~= speedSet then
		speedSet, speedBase, speedWritten = set, set and set.Value, nil
	end
	if not MOVE.speedOn or not hum then return end
	if not set then
		hum.WalkSpeed = MOVE.speed -- another place in the universe, without the game's system
		return
	end
	if set.Value ~= speedWritten then speedBase = set.Value end
	if set.Value ~= MOVE.speed then set.Value = MOVE.speed end
	speedWritten = MOVE.speed
end)

-- Infinite jump: every jump press in the air becomes a fresh jump. ChangeState(Jumping) uses the
-- JumpPower ClientCharacterSystem sets, so the game's own "no jumping" stuns still hold.
-- JumpRequest repeats while space is held; the gap keeps a held key to a steady climb.
do
	local lastAirJump = 0
	conns[#conns + 1] = UserInputService.JumpRequest:Connect(function()
		if not MOVE.infJump or os.clock() - lastAirJump < 0.2 then return end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		lastAirJump = os.clock()
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
end

----------------------------------------------------------------------
-- noclip
----------------------------------------------------------------------
-- Our character's physics runs on this client, so switching its parts' CanCollide off every
-- Stepped (the Humanoid turns some back on) walks it through walls. The Humanoid finds the floor
-- with a raycast rather than a collision, so you still stand on the ground.
local NOCLIP = { on = false, key = Enum.KeyCode.N }
local noclipSaved = setmetatable({}, { __mode = "k" }) -- parts we switched off, restored on exit
local noclipSwitch -- the Player tab's switch, so the hotkey flips it too

local function restoreCollision()
	for part in pairs(noclipSaved) do
		if part.Parent then part.CanCollide = true end
	end
	table.clear(noclipSaved)
end

local function setNoclip(v)
	NOCLIP.on = v
	if noclipSwitch then noclipSwitch(v) end
	if not v then restoreCollision() end
	notify("Noclip " .. (v and "on" or "off"))
end

conns[#conns + 1] = RunService.Stepped:Connect(function()
	if not NOCLIP.on then return end
	local char = LocalPlayer.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			noclipSaved[part] = true
			part.CanCollide = false
		end
	end
end)

----------------------------------------------------------------------
-- desync
----------------------------------------------------------------------
-- Each frame, right after physics (Heartbeat), the root is moved onto the marked spot -- that is
-- the position the client then replicates -- and put back before the next render. The server,
-- and everyone watching, keep seeing you parked on the spot while you walk around for real here.
-- Letting go stops the swap; the next update carries your real position and you pop up there.
local DESYNC = { markKey = Enum.KeyCode.V, holdKey = Enum.KeyCode.C, showGhost = true }
local desyncSpot = nil -- the CFrame everyone else keeps seeing
local desyncActive = false

-- God mode rides the same swap. Health is the server's (the character's Health script), and no
-- remote ever asks the victim's client to confirm a hit, so nothing client-side can refuse damage.
-- What the client does own is where the server sees its body: melee hitboxes are checked there,
-- and other players' guns aim at it. Parked `height` studs straight above you -- past the
-- 500 / 1000 stud reach of the game's gun rays -- nothing lands. dropToAttack comes back down
-- while you hold click so your own swings and shots connect.
local GOD = { on = false, height = 1200, dropToAttack = true, key = Enum.KeyCode.B }

-- local-only marker at the spot: parts under the camera never replicate
local ghost = new("Part", {
	Name = randomName(), Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
	Size = Vector3.new(2, 5, 1), Material = Enum.Material.ForceField, Color = T.accent,
	Transparency = 1, CastShadow = false,
})

local function refreshGhost()
	local cam = workspace.CurrentCamera
	local show = DESYNC.showGhost and desyncSpot ~= nil
	ghost.Transparency = show and (desyncActive and 0.15 or 0.55) or 1
	if desyncSpot then
		-- the root sits about 3 studs above the floor; the 5-stud body spans -3 .. +2 from it
		ghost.CFrame = desyncSpot * CFrame.new(0, -0.5, 0)
	end
	if cam and ghost.Parent ~= cam then ghost.Parent = cam end
end

local function rootPart()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function markDesyncSpot()
	local root = rootPart()
	if not root then return end
	desyncSpot = root.CFrame
	refreshGhost()
	notify("Desync spot marked")
end

local function startDesync()
	if desyncActive then return end
	if not desyncSpot then
		local root = rootPart()
		if not root then return end
		desyncSpot = root.CFrame -- no mark yet: freeze them on where you're standing now
	end
	desyncActive = true
	refreshGhost()
	notify("Desynced — they see you on the spot", T.accent2)
end

local function stopDesync()
	if not desyncActive then return end
	desyncActive = false
	refreshGhost()
	notify("Resynced")
end

local function clearDesyncSpot()
	desyncActive = false
	desyncSpot = nil
	refreshGhost()
end

local godSwitch -- the Player tab's switch, so the hotkey flips it too
local function setGod(v)
	GOD.on = v
	if godSwitch then godSwitch(v) end
	notify("God mode " .. (v and "on" or "off"), v and T.accent2 or nil)
end

local desyncStash = nil -- { root, real CFrame, real velocity } between the swap and the next render
local desyncRealPos = nil -- where you really are, for the status line (the root reads fake mid-swap)

local function restoreDesyncStash()
	local s = desyncStash
	desyncStash = nil
	if s and s[1].Parent then
		s[1].CFrame = s[2]
		s[1].AssemblyLinearVelocity = s[3]
	end
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
	-- a skipped render (minimised window) must not let the fake position become the "real" one
	restoreDesyncStash()
	local root = rootPart()
	if not root then return end
	local fake
	if desyncActive and desyncSpot then
		fake = desyncSpot
	elseif GOD.on and not (GOD.dropToAttack and meleeHeld) then
		fake = root.CFrame + Vector3.new(0, GOD.height, 0)
	end
	if not fake then return end
	desyncStash = { root, root.CFrame, root.AssemblyLinearVelocity }
	desyncRealPos = root.Position
	root.CFrame = fake
	root.AssemblyLinearVelocity = Vector3.zero
end)

-- First priority runs before input and the camera, so neither ever sees the spot
local DESYNC_BIND = randomName()
RunService:BindToRenderStep(DESYNC_BIND, Enum.RenderPriority.First.Value, restoreDesyncStash)

-- a spot from your last life means nothing after a respawn
conns[#conns + 1] = LocalPlayer.CharacterAdded:Connect(clearDesyncSpot)

----------------------------------------------------------------------
-- stick to target (melee reach)
----------------------------------------------------------------------
-- The server builds each swing's hitbox in front of our HumanoidRootPart, from the position this
-- client reports. While a melee swing is going, this parks us right behind (or in front of) the
-- target, facing them, so the box lands on them every swing. Behind also collects the backstab
-- bonus on weapons that have one. "Face" only turns us toward them, no teleport.
local STICK = { mode = "Off", range = 20, gap = 3 } -- mode: "Off" | "Behind" | "Front" | "Face"

-- the aimlock target when it's in range, otherwise the closest living enemy
local function stickTarget(myRoot)
	local best, bestDist = nil, STICK.range
	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer or (AIM.teamCheck and isTeammate(player)) then continue end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if hum and root and hum.Health > 0 then
			local d = (root.Position - myRoot.Position).Magnitude
			if player == State.target and d <= STICK.range then return root end
			if d < bestDist then best, bestDist = root, d end
		end
	end
	return best
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function()
	if STICK.mode == "Off" or not ((MELEE.enabled and MELEE.always) or meleeHeld) then return end
	-- while desynced (or up in god mode) the server swings from somewhere else, so parking next to
	-- them here would miss
	if desyncActive or (GOD.on and not (GOD.dropToAttack and meleeHeld)) then return end
	if not isMelee(heldTool()) then return end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not hum or hum.Health <= 0 then return end
	local target = stickTarget(root)
	if not target then return end

	local tpos = target.Position
	if STICK.mode == "Face" then
		local flat = Vector3.new(tpos.X, root.Position.Y, tpos.Z)
		if (flat - root.Position).Magnitude > 0.5 then
			root.CFrame = CFrame.lookAt(root.Position, flat)
		end
		return
	end

	local facing = target.CFrame.LookVector * Vector3.new(1, 0, 1)
	facing = facing.Magnitude > 1e-3 and facing.Unit or Vector3.new(0, 0, -1)
	local standAt = tpos + facing * (STICK.mode == "Behind" and -STICK.gap or STICK.gap)
	root.CFrame = CFrame.lookAt(standAt, Vector3.new(tpos.X, standAt.Y, tpos.Z))
	-- ride along with them instead of piling up our own fall speed between frames
	root.AssemblyLinearVelocity = target.AssemblyLinearVelocity
end)

----------------------------------------------------------------------
-- bullets through walls
----------------------------------------------------------------------
-- Every gun fires through ReplicatedStorage.FetchMousePos.ClientSidedRaycast: the client picks the
-- hit and sends the result table (Instance, Position, ClientHitSize, ...) on to the server. Guns
-- look the function up fresh on every shot (`local ClientSidedRaycast = FetchMousePos.Client...`
-- inside the fire loop), so swapping it on the module table covers all of them at once. The
-- replacement runs the original, then re-casts against player bodies only: whoever is under the
-- crosshair -- walls or not -- becomes the hit. Aiming at that point also drops the spread.
local WALLBANG = { on = false, available = false }
local unhookWallbang = function() end

do
	local module
	local filtergc = glob("filtergc")
	if filtergc then
		-- the exact table the game's scripts got from require, not a second copy
		local ok, found = pcall(filtergc, "table", { Keys = { "ClientSidedRaycast", "GetMousePosition" } }, true)
		if ok and type(found) == "table" then module = found end
	end
	if not module then
		local fmp = game:GetService("ReplicatedStorage"):FindFirstChild("FetchMousePos")
		local ok, m = pcall(function() return require(fmp) end)
		if ok and type(m) == "table" then module = m end
	end

	-- other players' bodies; accessories and held tools don't take damage, so they're left out
	local function enemyParts()
		local list = {}
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and not (AIM.teamCheck and isTeammate(player)) then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					for _, d in ipairs(char:GetDescendants()) do
						if d:IsA("BasePart") and not d:FindFirstAncestorWhichIsA("Accessory")
							and not d:FindFirstAncestorWhichIsA("Tool") then
							list[#list + 1] = d
						end
					end
				end
			end
		end
		return list
	end

	local function toPosition(v)
		if typeof(v) == "Vector3" then return v end
		if typeof(v) == "Instance" then
			if v:IsA("Attachment") then return v.WorldPosition end
			if v:IsA("BasePart") then return v.Position end
		end
		return nil
	end

	-- same shape FetchMousePos builds, so the gun and the server can't tell the difference
	local function asResult(original, hit)
		return {
			StartPos = original.StartPos,
			Position = hit.Position,
			Instance = hit.Instance,
			Distance = hit.Distance,
			ClientHitSize = hit.Instance.Size,
			Normal = hit.Normal,
			Material = hit.Material,
		}
	end

	local function throughWalls(original, startPos, towards, useCrosshair)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = enemyParts()
		params.CollisionGroup = RAY_GROUP

		local aimAt = towards
		local cam = workspace.CurrentCamera
		if useCrosshair and cam then
			local m = UserInputService:GetMouseLocation()
			local ray = cam:ViewportPointToRay(m.X, m.Y)
			local under = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
			if under then aimAt = under.Position end
		end
		if not aimAt then return original end
		local dir = aimAt - startPos
		if dir.Magnitude < 1e-3 then return original end
		local hit = workspace:Raycast(startPos, dir.Unit * 1000, params)
		return hit and asResult(original, hit) or original
	end

	if module and type(module.ClientSidedRaycast) == "function" then
		local origClientSided, origRaycast = module.ClientSidedRaycast, module.Raycast

		module.ClientSidedRaycast = function(origin, spread, ...)
			local result = origClientSided(origin, spread, ...)
			if not WALLBANG.on or type(result) ~= "table" then return result end
			local startPos = toPosition(origin)
			if not startPos then return result end
			-- never let a bug in here cost the shot: fall back to the gun's own result
			local ok, out = pcall(throughWalls, result, startPos, result.Position, true)
			return ok and out or result
		end

		if type(origRaycast) == "function" then
			module.Raycast = function(origin, target, ...)
				local result = origRaycast(origin, target, ...)
				if not WALLBANG.on or type(result) ~= "table" then return result end
				local startPos = toPosition(origin)
				if not startPos or typeof(target) ~= "Vector3" then return result end
				local ok, out = pcall(throughWalls, result, startPos, target, false)
				return ok and out or result
			end
		end

		unhookWallbang = function()
			module.ClientSidedRaycast = origClientSided
			if origRaycast then module.Raycast = origRaycast end
		end
		WALLBANG.available = true
	end
end

