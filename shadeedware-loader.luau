-- A previous run leaves a BindableEvent tagged "iahx" under the hidden host; firing it runs that
-- run's unload. Game scripts run at identity 2 and can't see in there.
local unloadBeacon
if not HOST_IS_VISIBLE then
	for _, v in ipairs(HOST:GetChildren()) do
		if v:IsA("BindableEvent") and v:GetAttribute("iahx") == true then
			pcall(function() v:Fire() end)
			task.wait(0.4)
		end
	end
	unloadBeacon = Instance.new("BindableEvent")
	unloadBeacon.Name = randomName()
	unloadBeacon:SetAttribute("iahx", true)
	unloadBeacon.Parent = HOST
end

