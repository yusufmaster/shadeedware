		Parent = t, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Text = text, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.text,
	})
	tween(t, 0.25, { BackgroundTransparency = 0.05 })
	tween(accentBar, 0.25, { BackgroundTransparency = 0 })
	tween(l, 0.25, { TextTransparency = 0 })
	tween(t:FindFirstChildOfClass("UIStroke"), 0.25, { Transparency = 0.5 })
	task.delay(duration or 2.6, function()
		tween(t, 0.3, { BackgroundTransparency = 1 })
		tween(l, 0.3, { TextTransparency = 1 })
		tween(accentBar, 0.3, { BackgroundTransparency = 1 })
		local s = t:FindFirstChildOfClass("UIStroke")
		if s then tween(s, 0.3, { Transparency = 1 }) end
		task.delay(0.35, function() t:Destroy() end)
	end)
end

