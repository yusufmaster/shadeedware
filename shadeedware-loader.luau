		local ok, h = pcall(gethui)
		if ok and h then HOST, HOST_IS_VISIBLE = h, false end
	end
	if HOST_IS_VISIBLE then
		local ok, cg = pcall(function() return game:GetService("CoreGui") end)
		if ok and cg then
			-- confirm we can actually touch it before committing
			local okw = pcall(function() return #cg:GetChildren() end)
			if okw then HOST, HOST_IS_VISIBLE = cg, false end
		end
