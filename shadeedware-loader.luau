		run = function()
-- ===== begin shadeedware.luau =====
--!nocheck
--[[
	SHADEEDWARE
	Auto Perfect Cast · Auto Shake · Auto Perfect Catch · Auto Quests · WalkSpeed

	WHAT CHANGED vs. the original, and why (every item is a thing that gets you kicked):

	1. Auto catch actually works now, and it works by playing the minigame.
	   The old code assigned reel.progress = 100. That was never going to do anything:
	   ReelController.Core.Minigame:16 builds progress as a modifier and recomputes it
	   from the modifier stack every tick, so the assignment is overwritten before the
	   >= 100 check on line 70 reads it. Same for perfect, cleared on line 65 every tick
	   the fish is off the bar. Instead we steer barPosition to track fishPosition —
	   IsInBar is just |fishPosition - barPosition| < barSize/2 + 0.005 — and the game
	   adds progress at the fish's real rate, on its own, with perfect intact.
	   Also handles StabController, Fisch's second minigame, which the old code ignored.

	2. Nothing is faked, so there is nothing to catch.
	   Duration, progress curve, BuildEndingData and the Snapshot log the server receives
	   are all genuinely produced by the minigame. The bar tracks with lag and a standing
	   offset because Snapshot ships bp/fp to the server and a bar pinned exactly on the
	   fish every sample would be its own signature.
	   (events.reelfinished does not exist in this build — the finish remote is
	   Net:RemoteEvent("Reel/Finish"). The old fallback was erroring inside its pcall.)

	3. Nothing is perfect 100% of the time.
	   Casts and catches each carry a deliberate imperfect rate. A player with a literal
	   100.0% perfect rate over 400 casts is detectable by statistics alone, no matter
	   how clean the client code is.

	4. All timing is drawn from distributions, not constants.
	   Gaussian reaction times, a fatigue drift that slows you down the longer you play,
	   occasional fumbles, and scheduled breaks. Fixed 0.07s / 0.4s loops are a fingerprint.

	5. Rate ceiling + breaks.
	   A rolling catches-per-hour cap and automatic short/long breaks. Throughput is the
	   metric that gets flagged first on any economy game.

	6. WalkSpeed is capped and ramped, and drops to 16 while a rod is out.
	   Humanoid.WalkSpeed replicates from your client. 250 is an instant flag. Hard cap 28,
	   eased over ~0.5s instead of a step change.

	7. No _G / shared footprint.
	   The old script left _G.__FISCH_HUB_UNLOAD behind. Game LocalScripts can read _G and
	   shared on some executors. Teardown now goes through a hidden BindableEvent under
	   gethui()/CoreGui, which identity-2 game scripts cannot touch.

	8. Quest remotes are spaced out.
	   The old questTick fired SelectQuest/ClaimQuest for every faction in a ~2s burst.
	   Now: one action per pass, human gaps, ~40–140s between passes.

	HONEST LIMIT: there is no "undetectable". Perfect catches are scored server-side.
	The only real defense is looking like a fast human instead of a machine, and not
	out-earning what a human can. Turn the imperfect rates DOWN and the hourly cap UP
	and you are trading safety for yield — that dial is yours.

	SETUP: set ICON_ID below to your own uploaded decal, e.g. "rbxassetid://1234567890".
	       Leave it "" and the splash falls back to your Roblox headshot.
--]]

-- Splash / header image. ICON_FILE is a local file in the executor's workspace ROOT
-- (AppData\Local\Potassium\workspace on this machine). Tested: Potassium's getcustomasset
-- only resolves files sitting at that root -- a subfolder path returns a URL that silently
-- decodes to 0x0 -- so keep the image there rather than in a folder.
-- shadeedware-loader.luau carries the image and writes this file for whoever runs it.
-- The loader fills SHADEEDWARE_ICONS with one workspace file per bundled picture. Each picture needs
-- its own filename: Roblox caches a getcustomasset URL for the whole session, so overwriting one
-- file keeps showing the first image.
local ICON_RNG = Random.new()
local ICON_POOL = type(SHADEEDWARE_ICONS) == "table" and #SHADEEDWARE_ICONS > 0 and SHADEEDWARE_ICONS or { "shadeed.jpg" }
local ICON_FILE = ICON_POOL[1] -- swapped for the next pick in the cycle once glob exists
local VIDEO_POOL = type(SHADEEDWARE_VIDEOS) == "table" and SHADEEDWARE_VIDEOS or {}
-- controller-only extras (the loader's assets/remote): never in a rotation, shown only on request
local REMOTE_POOL = type(SHADEEDWARE_REMOTE) == "table" and SHADEEDWARE_REMOTE or { images = {}, anims = {} }
local ICON_ID = "" -- optional rbxassetid:// override, wins over ICON_FILE

----------------------------------------------------------------------
-- tunables
----------------------------------------------------------------------
local CFG = {
	-- 0 = every cast and every catch is perfect. That is what you asked for and it is
	-- what ships. The sliders on the Safety tab raise these live if you ever want to
	-- trade yield for a less machine-shaped profile.
	imperfectCastRate  = 0,    -- fraction of casts released off the perfect window
	imperfectCatchRate = 0,    -- fraction of reels finished without perfect
	shakeFumbleRate    = 0.06, -- fraction of shakes answered late, like a missed click

	catchesPerHour     = 260,  -- rolling ceiling; casting holds once hit
	breakEveryCatches  = 38,   -- short break cadence (randomized around this)

	maxWalkSpeed       = 28,   -- hard ceiling. above ~24 Fisch's movement check gets loud
	speedOnlyIdle      = true, -- drop to 16 whenever a rod is casting/searching/reeling
}

----------------------------------------------------------------------
-- services
----------------------------------------------------------------------
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

----------------------------------------------------------------------
-- executor shims
----------------------------------------------------------------------
-- Resolve executor globals through normal indexing. rawget(getfenv(), ...) misses
-- them on executors that hand out their API via a metatable on the global env.
local function glob(name)
	local ok, v = pcall(function()
		return (getfenv and getfenv(1) or _G)[name]
	end)
	if ok and v ~= nil then return v end
	ok, v = pcall(function() return _G[name] end)
	if ok and v ~= nil then return v end
	return nil
end

local syn = glob("syn")
local getconnections = glob("getconnections")
	or glob("get_signal_cons")
	or glob("getsignalcons")
	or (syn and syn.get_connections)
local firesignal = glob("firesignal") or glob("fire_signal")
local gethui = glob("gethui") or glob("get_hidden_gui")

-- Run this file directly instead of through the loader and SHADEEDWARE_ICONS never gets set,
-- which used to leave you with the one fallback picture and no clips -- and the rotation saved
-- below shrank to match, wiping the queue for the next proper run too. The loader leaves a
-- manifest of everything it wrote, so a direct run shows the same gallery the loader does.
if not (type(SHADEEDWARE_ICONS) == "table" and #SHADEEDWARE_ICONS > 0) then
	local rf, isf = glob("readfile"), glob("isfile")
	local ok, manifest = pcall(function()
		return game:GetService("HttpService"):JSONDecode(rf("shadeed_manifest.json"))
	end)
	if ok and type(manifest) == "table" then
		local function present(f)
			if not isf then return true end
			local okc, r = pcall(isf, f)
			return okc and r == true
		end
		local icons, vids = {}, {}
		for _, f in ipairs(type(manifest.icons) == "table" and manifest.icons or {}) do
			if type(f) == "string" and present(f) then table.insert(icons, f) end
		end
		for _, v in ipairs(type(manifest.videos) == "table" and manifest.videos or {}) do
			if type(v) == "table" and type(v.audio) == "string" and type(v.sheets) == "table" and present(v.audio) then
				table.insert(vids, v)
			end
		end
		if #icons > 0 then ICON_POOL, ICON_FILE = icons, icons[1] end
		if #vids > 0 then VIDEO_POOL = vids end
		local remote = type(manifest.remote) == "table" and manifest.remote or {}
		local ri, ra = {}, {}
		for _, f in ipairs(type(remote.images) == "table" and remote.images or {}) do
			if type(f) == "string" and present(f) then table.insert(ri, f) end
		end
		for _, a in ipairs(type(remote.anims) == "table" and remote.anims or {}) do
			if type(a) == "table" and type(a.id) == "string" and type(a.sheets) == "table"
				and type(a.sheets[1]) == "string" and present(a.sheets[1]) then
				table.insert(ra, a)
			end
		end
		if #ri + #ra > 0 then REMOTE_POOL = { images = ri, anims = ra } end
	end
end

-- Pictures and clips go through a shuffled cycle saved in the workspace, so nothing repeats
-- until everything has had a turn, re-executes included.
local CYCLE_FILE = "shadeed_cycle.json"

local function shuffled(list)
	local out = table.clone(list)
	for i = #out, 2, -1 do
		local j = ICON_RNG:NextInteger(1, i)
		out[i], out[j] = out[j], out[i]
	end
	return out
end

local function nextInCycle(key, valid, build)
	local HttpService = game:GetService("HttpService")
	local rf, wf = glob("readfile"), glob("writefile")
	local state = {}
	local okR, decoded = pcall(function() return HttpService:JSONDecode(rf(CYCLE_FILE)) end)
	if okR and type(decoded) == "table" then state = decoded end

	-- drop anything that's no longer bundled (the gallery changed since the file was saved)
	local queue = {}
	if type(state[key]) == "table" then
		for _, item in ipairs(state[key]) do
			if valid[item] then table.insert(queue, item) end
		end
	end
	if #queue == 0 then
		queue = build()
		-- don't let a fresh cycle open with whatever closed the last one
		if #queue > 1 and queue[1] == state[key .. "Last"] then
			queue[1], queue[2] = queue[2], queue[1]
		end
	end

	local item = table.remove(queue, 1)
	state[key], state[key .. "Last"] = queue, item
	if wf then pcall(function() wf(CYCLE_FILE, HttpService:JSONEncode(state)) end) end
	return item
end

do
	local valid = {}
	for _, f in ipairs(ICON_POOL) do valid[f] = true end
	ICON_FILE = nextInCycle("icon", valid, function() return shuffled(ICON_POOL) end) or ICON_FILE
end
