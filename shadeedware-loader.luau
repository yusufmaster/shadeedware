local StarterGui = game:GetService("StarterGui")
local MarketplaceService = game:GetService("MarketplaceService")

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "ShadeedWare", Text = text, Duration = 6 })
	end)
end

-- "[🧲] Blox Fruits" / "Fisch 📜 [JOURNAL]" -> "blox fruits" / "fisch"
local function normalize(name)
	name = string.lower(name):gsub("%b[]", ""):gsub("%b()", ""):gsub("[\128-\255]", "")
	return (name:gsub("%s+", " "):match("^%s*(.-)%s*$"))
end

if not game:IsLoaded() then game.Loaded:Wait() end
-- GameId can read 0 for a moment right after joining
local deadline = os.clock() + 5
while game.GameId == 0 and os.clock() < deadline do task.wait(0.1) end

local function detect()
	for _, g in ipairs(GAMES) do
		if table.find(g.universeIds, game.GameId) or table.find(g.placeIds, game.PlaceId) then
			return g
		end
	end

	-- unknown ids: match on the game's name, ignoring [update tags] and emoji. Exact match only,
	-- so "Blox Fruits Simulator" doesn't get the Blox Fruits hub.
	local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
	local gameName = ok and type(info) == "table" and info.Name or nil
	if gameName then
		local key = normalize(gameName)
		for _, g in ipairs(GAMES) do
			if normalize(g.name) == key then return g end
		end
	end
	return nil, gameName
end

local picked, gameName = detect()
if not picked then
	local names = {}
	for _, g in ipairs(GAMES) do names[#names + 1] = g.name end
	notify(string.format("%s isn't supported. Works in: %s", gameName or "This game", table.concat(names, ", ")))
	return
end

