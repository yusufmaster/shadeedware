	or glob("get_signal_cons")
	or glob("getsignalcons")
	or (syn and syn.get_connections)

-- Fires a signal's Lua listeners on fresh threads so a yielding handler can't stall the caller.
local function fireListeners(signal, ...)
	local args = table.pack(...)

	if firesignal then
		local ok = pcall(firesignal, signal, ...)
		if ok then return true end
	end

	if getconnections then
		local ok, cons = pcall(getconnections, signal)
		if ok and type(cons) == "table" then
			local hit = false
			for _, c in ipairs(cons) do
				local okf, f = pcall(function() return c.Function end)
				if okf and type(f) == "function" then
					hit = true
					task.spawn(f, table.unpack(args, 1, args.n))
				end
			end
			if hit then return true end
		end
	end

	return false
end

