-- game helpers
----------------------------------------------------------------------
local events = ReplicatedStorage:WaitForChild("events")

local function character() return LocalPlayer.Character end
local function humanoid()
	local c = character()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function isRod(tool)
	return tool
		and tool:IsA("Tool")
		and tool:FindFirstChild("values")
		and tool.values:FindFirstChild("state")
		and tool:FindFirstChild("events")
		and tool.events:FindFirstChild("castAsync")
end

local function equippedRod()
	local c = character()
	if not c then return nil end
	for _, t in ipairs(c:GetChildren()) do
		if isRod(t) then return t end
	end
	return nil
end

local function backpackRod()
	for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
		if isRod(t) then return t end
	end
	return nil
end

local function rodState()
	local r = equippedRod()
	return r and r.values.state.Value or nil, r
end

local function fishButton()
	local sg = PlayerGui:FindFirstChild("FishButtonMobile")
	if not sg then return nil end
	local f = sg:FindFirstChild("Frame")
	return f and f:FindFirstChild("button") or nil
end

-- the charge bar rod/client parents to the character while holding
local function powerBillboard()
	local c = character()
	if not c then return nil end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BillboardGui") and (d.Name == "power" or d.Name == "thunderpower") then
			return d
		end
	end
	return nil
end

-- Fisch runs two interchangeable catch minigames, ReelController and StabController,
-- with identical shape (progress, perfect, barPosition, fishPosition, ActiveReel).
-- The old code only knew about the reel, so every stab fish went unhandled.
local _ctrls = nil
local function controllers()
	if _ctrls then return _ctrls end
	local folder = ReplicatedStorage.client.legacyControllers
	local out = {}
	for _, name in ipairs({ "ReelController", "StabController" }) do
		local mod = folder:FindFirstChild(name)
		if mod then
			local ok, m = pcall(require, mod)
			if ok and type(m) == "table" then out[#out + 1] = m end
		end
	end
	if #out > 0 then _ctrls = out end
	return out
end

-- The live minigame instance, or nil. ActiveReel is assigned on the class table at
-- ReelController line 601 for non-mock reels and cleared in Destroy.
local function activeMinigame()
	for _, ctrl in ipairs(controllers()) do
		local inst = rawget(ctrl, "ActiveReel")
		if type(inst) == "table" and rawget(inst, "active") ~= false then
			return inst
		end
	end
	return nil
end

local function rodBusy()
	local st = rodState()
	return st == ROD_STATE.Casting
		or st == ROD_STATE.Searching
		or st == ROD_STATE.Luring
		or st == ROD_STATE.PreReel
		or st == ROD_STATE.Reeling
end

----------------------------------------------------------------------
-- feature: auto cast (perfect most of the time, on purpose)
----------------------------------------------------------------------
-- rod/client, line 682:  local v60 = 96 - v51 * 2   -- perfect is  v60 < power
-- v51 is the bar's per-tick speed and is always positive, so the perfect floor is
-- always strictly under 96. Anything above 96 is perfect on every rod; anything at
-- or under ~88 reliably is not. We aim at a drawn target instead of slamming the
-- bar at max every single time.
local casting = false

local function drawCastTarget()
	if chance(CFG.imperfectCastRate) then
		return rng:NextNumber(56, 87), false
	end
	-- Aim at the MIDDLE of the perfect band, not its top. The floor is 96 - v51*2 with
	-- v51 positive, so ~94 upward is perfect; releasing on the cross at ~96 lands
	-- somewhere in 96-100 once our InputEnded registers, with room to spare even if
	-- the bar peaked and started back down first. Aiming at 98+ left no such room.
	return gauss(96.0, 0.7, 94.8, 97.6), true
end

local function doCast()
	local btn = fishButton()
	if not btn then return false, "FishButtonMobile missing" end

	if not fireListeners(btn.InputBegan, FAKE_INPUT) then
		return false, "executor has no getconnections/firesignal"
	end

	-- wait for the charge bar to spawn
	local bb, t0 = nil, os.clock()
	repeat
		task.wait(0.03)
		bb = powerBillboard()
	until bb or os.clock() - t0 > 3

	if not bb then
		fireListeners(btn.InputEnded, FAKE_INPUT)
		return false, "charge never started"
	end

	if bb.Name == "thunderpower" then
		-- thundermaul charge is pinned at 100 the whole time; still take a human beat
		task.wait(Behavior.reaction(0.28, 0.09, 0.12, 0.7))
		fireListeners(btn.InputEnded, FAKE_INPUT)
		Behavior.castTotal += 1
		Behavior.castPerfect += 1
		State.casts += 1
		return true
	end

	local bar = bb:FindFirstChild("powerbar") and bb.powerbar:FindFirstChild("bar")
	if not bar then
		task.wait(gauss(0.85, 0.2, 0.4, 1.6))
		fireListeners(btn.InputEnded, FAKE_INPUT)
		Behavior.castTotal += 1
		State.casts += 1
		return true
	end

	local target, wantPerfect = drawCastTarget()

	-- Release the instant the bar crosses the window while still rising, with no
	-- artificial delay. The power bar oscillates: rod/client's charge loop drives
	-- u15.power up and back down, so pausing even 100ms after deciding means letting
	-- go on the way back down, under the floor. The few frames our InputEnded takes
	-- to register carry the bar further UP, which is free -- the perfect floor is
	-- 96 - v51*2 with v51 positive, so anything from ~94 to 100 is perfect anyway.
	local lastP = 0
	local t1 = os.clock()

	while os.clock() - t1 < 8 do
		if not bar.Parent then break end

		local p = bar.Size.Y.Scale * 100
		local rising = p >= lastP

		if rising and p >= target then break end
		if p >= 99.5 then break end
		-- already past the peak: take it now, before it falls out of the window
		if not rising and lastP >= target then break end

		lastP = p
		RunService.Heartbeat:Wait()
	end

	fireListeners(btn.InputEnded, FAKE_INPUT)

	Behavior.castTotal += 1
	if wantPerfect then Behavior.castPerfect += 1 end
	State.casts += 1
	return true
end

-- A bobber that lands on rock or sand sits in Searching forever, because Fisch
-- only bites inside a zone. Clicking while Searching/Luring reels the line back
-- in (rod/client's second input branch), which is exactly what we want here.
local function cancelCast()
	local btn = fishButton()
	if btn then fireListeners(btn.InputBegan, FAKE_INPUT) end
end

-- note: rod.values.bobberzone stays empty on perfectly good open-water casts
-- (it only names special zones), so it is NOT a usable "did the cast land" test.

----------------------------------------------------------------------
-- water finding: walk to the shore instead of casting onto land
----------------------------------------------------------------------
-- Fisch's water is terrain water, and the server throws the bobber straight ahead of the
-- character (~25 studs on a perfect cast). The map is full of invisible non-collidable zone
-- parts over the water that the bobber falls through, so every ray respects CanCollide;
-- invisible collidable parts like dock hitboxes do stop the bobber and count as land.
local PathfindingService = game:GetService("PathfindingService")
local WATER_SEARCH_RADIUS = 250
local castReach = 25 -- corrected from where the bobber really lands
local walkingToWater = false
local trustedSpot = nil -- where a cast got a bite, e.g. lava or special zones that aren't water
local badSpots = {}

local function flat(v) return Vector3.new(v.X, 0, v.Z) end

local function rootPart()
	local c = character()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function rayParams()
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.IgnoreWater = false
	rp.RespectCanCollide = true
	local ignore = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(ignore, p.Character) end
	end
	rp.FilterDescendantsInstances = ignore
	return rp
end

-- "water" / "ground" (plus the hit) for whatever is first below a point
local function surfaceAt(pos, fromY, rp)
	local hit = workspace:Raycast(Vector3.new(pos.X, fromY, pos.Z), Vector3.new(0, -100, 0), rp)
	if not hit then return nil end
	return hit.Material == Enum.Material.Water and "water" or "ground", hit
end

local function castLandsInWater(stand, dir, rp)
	for offset = -6, 6, 3 do
		if surfaceAt(stand + dir * (castReach + offset), stand.Y + 20, rp) ~= "water" then return false end
	end
	return true
end

local function isBadSpot(stand, dir)
	for _, b in ipairs(badSpots) do
		if flat(b.pos - stand).Magnitude < 5 and (b.dir == nil or b.dir:Dot(dir) > 0.9) then return true end
	end
	return false
end

-- nearest place on similar ground height with water a cast-length away, searched outward in rings
local function findCastSpot()
	local hrp = rootPart()
	if not hrp then return nil end
	local rp, origin = rayParams(), hrp.Position
	local dirs = {}
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		dirs[i + 1] = Vector3.new(math.cos(a), 0, math.sin(a))
	end
	-- rays start well above the player so a beach far below a hilltop town still counts
	for radius = 0, WATER_SEARCH_RADIUS, 6 do
		local count = radius == 0 and 1 or math.max(8, math.floor(radius * math.pi * 2 / 6))
		for i = 0, count - 1 do
			local a = i / count * math.pi * 2
			local probe = origin + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
			local kind, hit = surfaceAt(probe, origin.Y + 25, rp)
			if kind == "ground" and hit.Position.Y > origin.Y - 60 then
				local stand = hit.Position + Vector3.new(0, 3, 0)
				for _, dir in ipairs(dirs) do
					if castLandsInWater(stand, dir, rp) and not isBadSpot(stand, dir) then
						return stand, dir
					end
				end
			end
		end
		if radius % 30 == 0 then task.wait() end
	end
	return nil
end

local function walkTo(target)
	local h, hrp = humanoid(), rootPart()
	if not (h and hrp) then return false end
	local waypoints = { { Position = target, Action = Enum.PathWaypointAction.Walk } }
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 })
	if pcall(function() path:ComputeAsync(hrp.Position, target) end) and path.Status == Enum.PathStatus.Success then
		waypoints = path:GetWaypoints()
	end
	for _, wp in ipairs(waypoints) do
		if not (State.autoCast and State.running and State.walkToWater) then break end
		if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
		h:MoveTo(wp.Position)
		local t0 = os.clock()
		local limit = flat(wp.Position - hrp.Position).Magnitude / math.max(h.WalkSpeed, 8) + 2
		while flat(wp.Position - hrp.Position).Magnitude > 3 and os.clock() - t0 < limit do
			if not State.autoCast then break end
			task.wait(0.1)
		end
		if os.clock() - t0 >= limit then h.Jump = true end
	end
	h:MoveTo(hrp.Position)
	return flat(target - hrp.Position).Magnitude < 6
end

local lastNoWaterNote = 0
local function goToWater(reason)
	local stand, dir = findCastSpot()
	if not stand then
		if os.clock() - lastNoWaterNote > 30 then
			lastNoWaterNote = os.clock()
			notify("No water to cast into within " .. WATER_SEARCH_RADIUS .. " studs — move closer to water", T.danger)
		end
		return false
	end
	local hrp = rootPart()
	if flat(stand - hrp.Position).Magnitude > 4 then
		notify(reason)
		walkingToWater = true
		local arrived = walkTo(stand)
		walkingToWater = false
		if not arrived then
			-- couldn't get there (wall, cliff, gap): try a different spot next time
			table.insert(badSpots, { pos = stand })
			return false
		end
		task.wait(Behavior.reaction(0.35, 0.1, 0.15, 0.8))
	end
	hrp = rootPart()
	if hrp then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir) end
	return true
end

local function atTrustedSpot()
	local hrp = rootPart()
	return trustedSpot and hrp and flat(trustedSpot.pos - hrp.Position).Magnitude < 4
		and flat(hrp.CFrame.LookVector).Unit:Dot(trustedSpot.dir) > 0.9
end

-- true when standing somewhere a cast lands in water; walks there first when it doesn't
local function ensureFacingWater()
	local h, hrp = humanoid(), rootPart()
	if not (h and hrp) then return false end
	local swimming = h:GetState() == Enum.HumanoidStateType.Swimming
	if not swimming and (atTrustedSpot() or castLandsInWater(hrp.Position, flat(hrp.CFrame.LookVector).Unit, rayParams())) then
		return true
	end
	return goToWater(swimming and "You're in the water — heading back to shore" or "Not facing water — walking to the shore")
end

-- After a cast: let the bobber settle, then make sure it's floating on water and not sitting on
-- sand, rock or a dock. Returns false when the cast was bad and has been reeled in.
local landFails = 0
local function checkLanding(rod)
	local hrp = rootPart()
	if not hrp then return true end
	local standPos, standDir = hrp.Position, flat(hrp.CFrame.LookVector).Unit
	local values = rod.values

	local t0 = os.clock()
	while os.clock() - t0 < 4 and values.state.Value ~= ROD_STATE.Searching do
		if values.state.Value >= ROD_STATE.Luring or activeMinigame() then return true end
		if values.state.Value <= ROD_STATE.Equipped and os.clock() - t0 > 1.5 then return true end
		task.wait(0.1)
	end
	local bobber = rod:FindFirstChild("bobber")
	if values.state.Value ~= ROD_STATE.Searching or not bobber then return true end

	local still = 0
	t0 = os.clock()
	while os.clock() - t0 < 3 and still < 3 do
		still = bobber.AssemblyLinearVelocity.Magnitude < 1 and still + 1 or 0
		task.wait(0.1)
	end
	if values.state.Value ~= ROD_STATE.Searching then return true end
	-- a named fishing zone (lava pools etc.) is fine even when it isn't water; no zone reads "nil"
	local zone = values:FindFirstChild("bobberzone") and values.bobberzone.Value
	if type(zone) == "string" and zone ~= "" and zone ~= "nil" then return true end

	local reach = flat(bobber.Position - standPos).Magnitude
	if reach > 5 then castReach = math.clamp(reach, 8, 80) end

	local hit = workspace:Raycast(bobber.Position + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), rayParams())
	if hit and hit.Material == Enum.Material.Water then
		landFails = 0
		return true
	end
	if atTrustedSpot() then return true end

	landFails += 1
	notify(string.format("Cast isn't in the water (%s) — reeling in and moving",
		hit and (string.lower(hit.Material.Name) .. " under the bobber") or "nothing under the bobber"), T.warn)
	table.insert(badSpots, { pos = standPos, dir = standDir })
	if #badSpots > 30 then table.remove(badSpots, 1) end
	cancelCast()
	task.wait(gauss(1.2, 0.3, 0.7, 2))

	if landFails >= 5 then
		landFails = 0
		State.autoCast = false
		if setCast then setCast(false) end
		notify("Five casts in a row missed the water — auto cast off. Move somewhere with open water.", T.danger)
	end
	return false
end

task.spawn(function()
	local waitingSince, lastState = nil, nil
	local landingChecked = false

	while State.running do
		task.wait(0.2)
		if State.autoCast and not casting then
			local ok = pcall(function()
				if activeMinigame() then waitingSince = nil return end
				if PlayerGui:FindFirstChild("shakeui") then waitingSince = nil return end

				local rod = equippedRod()
				if not rod then
					waitingSince = nil
					local h, spare = humanoid(), backpackRod()
					if h and spare then
						task.wait(Behavior.reaction(0.4, 0.15, 0.15, 1.2))
						h:EquipTool(spare)
					end
					return
				end

				local st = rod.values.state.Value
				if st ~= lastState then
					lastState = st
					waitingSince = os.clock()
				end

				if st == ROD_STATE.Equipped then landingChecked = false end

				if st == ROD_STATE.Equipped and not rod.values.casted.Value then
					-- breaks, hourly ceiling: hold here, never mid-fish
					local blocker = Behavior.castBlocker()
					if blocker then
						State.hold = blocker
						return
					end
					State.hold = nil

					if State.walkToWater and not ensureFacingWater() then
						waitingSince = nil
						task.wait(1)
						return
					end

					casting = true
					local success, why = doCast()
					casting = false
					if not success and why then notify(why, T.danger) end
					if success and State.walkToWater then
						landingChecked = true
						if not checkLanding(rod) then
							waitingSince = nil
							return
						end
					end
					task.wait(math.max(0, gauss(State.recastDelay, State.recastDelay * 0.45, 0.25)))
					waitingSince = os.clock()

				elseif st == ROD_STATE.Searching or st == ROD_STATE.Luring then
					-- a line that was already out (cast by hand, or before auto cast was on)
					if st == ROD_STATE.Searching and State.walkToWater and not landingChecked then
						landingChecked = true
						if not checkLanding(rod) then
							waitingSince = nil
							return
						end
					end
					if st == ROD_STATE.Luring then
						local hrp = rootPart()
						if hrp then trustedSpot = { pos = hrp.Position, dir = flat(hrp.CFrame.LookVector).Unit } end
					end
					-- only recover from a genuinely stuck line (bobber on land, etc.)
					local waited = os.clock() - (waitingSince or os.clock())
					if waited > State.stallTimeout then
						cancelCast()
						notify("No bite in " .. math.floor(State.stallTimeout) .. "s — reeling in")
						waitingSince = os.clock() + 3
						task.wait(gauss(1.6, 0.5, 0.8, 3.5))
					end
				end
			end)
			if not ok then casting = false end
		end
	end
end)

----------------------------------------------------------------------
-- watchdog: the server refusing casts
----------------------------------------------------------------------
-- castAsync is a RemoteFunction. rod/client line 718:
--     if not u10:InvokeServer(math.clamp(u15.power, 0, 100), v60 <= u15.power) then
--         warn("[rod/client] cast rejected by server")
-- The client's whole response is reset(). The old hub's response was to cast again
-- three seconds later, and again, and again. Your console has three of those in a row
-- from the last session. Hammering a server that has already decided something is
-- wrong with you is how a warning turns into a kick, so: back off, and escalate.
local rejections, lastRejection = 0, 0

pcall(function()
	game:GetService("LogService").MessageOut:Connect(function(msg, mt)
		if mt ~= Enum.MessageType.MessageWarning then return end
		if not string.find(msg, "cast rejected by server", 1, true) then return end

		-- refusals ten minutes apart aren't the same incident
		if os.clock() - lastRejection > 600 then rejections = 0 end
		lastRejection = os.clock()
		rejections += 1

		local base = ({ 25, 90, 240 })[math.min(rejections, 3)]
		local hold = gauss(base, base * 0.2, base * 0.6)
		Behavior.pauseFor(hold, "server refused a cast")
		notify(string.format("Cast rejected ×%d — holding %ds", rejections, math.ceil(hold)), T.danger)

		if rejections >= 3 then
			State.autoCast = false
			if setCast then setCast(false) end
			notify("Three refusals — auto cast off. Move spots.", T.danger)
		end
	end)
end)

----------------------------------------------------------------------
-- feature: auto shake
----------------------------------------------------------------------
-- Fisch's shake prompt jumps to a new screen position each step. We watch for the
-- jump, then answer it after a drawn reaction time — with the occasional fumble,
-- because a 70ms response on every single prompt forever is not a person.
local function shakeButton()
	local ui = PlayerGui:FindFirstChild("shakeui")
	if not ui then return nil end
	local zone = ui:FindFirstChild("safezone") or ui
	for _, d in ipairs(zone:GetDescendants()) do
		if d:IsA("GuiButton") then return d end
	end
	return nil
end

task.spawn(function()
	local lastPos, dueAt, retryAt = nil, nil, nil

	while State.running do
		task.wait(0.03)
		if not State.autoShake then
			lastPos, dueAt, retryAt = nil, nil, nil
			continue
		end

		local b = shakeButton()
		if not b then
			lastPos, dueAt, retryAt = nil, nil, nil
			continue
		end

		local pos = b.AbsolutePosition
		if lastPos == nil or (pos - lastPos).Magnitude > 4 then
			lastPos = pos
			local r = Behavior.reaction(0.215, 0.058, 0.115, 0.5)
			if chance(CFG.shakeFumbleRate) then r = r * rng:NextNumber(2.1, 4.2) end
			dueAt, retryAt = os.clock() + r, nil
		end

		if dueAt and os.clock() >= dueAt then
			pcall(fireListeners, b.Activated)
			dueAt = nil
			-- if the prompt happens to respawn in the same spot, position-watching
			-- won't see it, so arm a human-speed retry
			retryAt = os.clock() + gauss(0.62, 0.16, 0.36, 1.3)
		elseif retryAt and os.clock() >= retryAt then
			pcall(fireListeners, b.Activated)
			retryAt = os.clock() + gauss(0.62, 0.16, 0.36, 1.3)
		end
	end
end)

----------------------------------------------------------------------
-- feature: auto catch
----------------------------------------------------------------------
-- Writing reel.progress does nothing, which is why the old version never worked.
-- ReelController.Core.Minigame:16 builds progress as a modifier:
--     v3._progressModifier = p2:CreateModifier("progress", "add")
-- and its Tick recomputes the value every frame from that modifier stack, so a raw
-- assignment is gone before the >= 100 check on line 70 ever reads it. perfect is
-- no better: line 65 sets it false on every tick the fish is off the bar.
--
-- So drive the thing the minigame actually reads. Tick calls:
--     current.onbar = current:IsInBar(current.fishPosition, 0.01)
-- and IsInBar (line 458) is just  |fishPosition - barPosition| < barSize/2 + 0.005.
-- Keep the fish on the bar and the game's own tick adds progress at the fish's real
-- rate and never clears perfect: duration, progress curve, ending data and the
-- Snapshot log are all genuine. There is nothing left to fake, which is the point.
--
-- Snapshot (line 838) ships bp=barPosition and fp=fishPosition to the server, so the
-- bar is never pinned to the fish: the controller below orbits it. A bar equal to the
-- fish position to the last decimal on every sample is its own signature.
-- We do NOT write barPosition. Core.RodMovement:98 is
--     current.barPosition = current.barPosition + u10.CurrentVelocity * p11
-- so the bar is a physics integrator: it adds CurrentVelocity * dt on top of any
-- value written to it, every frame, and a positional write leaves that velocity
-- untouched. That momentum term is what made the old tracking lag the fish.
--
-- Instead we set CurrentInputDirection, which RodMovement:17 initialises to -1 and
-- otherwise only changes inside its InputBegan/InputEnded handlers. It is a binary
-- hold/release -- literally the mouse button -- so driving it is the same input a
-- player gives, and the game's own SmoothDamp, acceleration and bounce produce the
-- motion. No integrator to fight, and no steady-state error.
local Track = {
	handle = nil,
	rod = nil,
	dir = -1,
	nextFlipAt = 0,
	offset = 0,
	nextOffsetAt = 0,
	slipUntil = 0,
	perfect = true,
}

-- the minigame's RodMovement. WyvernBehavior:176 reaches it as current.core.rod;
-- the scan is a fallback in case a variant nests it elsewhere.
local function rodMover(m)
	local ok, r = pcall(function() return m.core and m.core.rod end)
	if ok and type(r) == "table" and rawget(r, "CurrentInputDirection") ~= nil then return r end
	local okScan, found = pcall(function()
		for _, v in pairs(m) do
			if type(v) == "table" then
				if rawget(v, "CurrentInputDirection") ~= nil then return v end
				for _, w in pairs(v) do
					if type(w) == "table" and rawget(w, "CurrentInputDirection") ~= nil then return w end
				end
			end
		end
		return nil
	end)
	return okScan and found or nil
end

local function beginTrack(m)
	Track.handle = m
	Track.rod = rodMover(m)
	Track.dir = -1
	Track.nextFlipAt = 0
	Track.offset = 0
	Track.nextOffsetAt = 0
	Track.slipUntil = 0
	Track.perfect = not chance(CFG.imperfectCatchRate)

	-- Position tracking no longer needs this handle; without it we just cannot zero
	-- the velocity first, so the bar can drift a little. Worth knowing, not fatal.
	if not Track.rod and rawget(getmetatable(m) or {}, "type") ~= "stab" then
		notify("No RodMovement handle — tracking may drift", T.warn)
	end

	if not Track.perfect then
		-- hold the wrong way for a beat so the fish genuinely leaves the bar.
		-- perfect then clears through the game's own tick rather than us writing
		-- the flag, and it costs a little progress exactly as a real slip would
		task.delay(gauss(1.5, 0.6, 0.5), function()
			if Track.handle == m then
				Track.slipUntil = os.clock() + gauss(0.5, 0.15, 0.25)
			end
		end)
	end
end


RunService.Heartbeat:Connect(function()
	if not State.autoCatch then
		Track.handle = nil
		return
	end

	local m = activeMinigame()
	if not m then
		Track.handle = nil
		return
	end

	if Track.handle ~= m then beginTrack(m) end
	local rod = Track.rod

	pcall(function()
		local fish, size, bar = m.fishPosition, m.barSize, m.barPosition
		if type(fish) ~= "number" or type(size) ~= "number" or type(bar) ~= "number" then return end
		if size <= 0 or size >= 1 then return end

		-- a small standing aim error so barPosition never reads exactly equal to
		-- fishPosition in the Snapshot log. Well inside the bar, so it costs nothing.
		if os.clock() >= Track.nextOffsetAt then
			Track.nextOffsetAt = os.clock() + gauss(0.9, 0.3, 0.3)
			Track.offset = rng:NextNumber(-1, 1) * size * 0.10
		end

		local lo, hi = size / 2, 1 - size / 2
		if hi <= lo then return end

		local target
		if os.clock() < Track.slipUntil then
			-- only reachable when imperfectCatchRate > 0
			target = math.clamp(fish + (fish > bar and -1 or 1) * (size * 0.5 + 0.06), 0, 1)
		else
			target = math.clamp(fish + Track.offset, lo, hi)
		end

		-- Kill the integrator BEFORE placing the bar. This is the step I missed:
		-- RodMovement:98 does barPosition += CurrentVelocity * dt every frame, so a
		-- positional write with momentum still in CurrentVelocity gets carried off it
		-- immediately -- that was the lag. Zeroed, the write holds exactly.
		if rod then
			rod.CurrentVelocity = 0
			rod.CurrentAcceleration = 0
			-- point the input the same way, so any residual step lands toward the fish
			rod.CurrentInputDirection = (target > bar) and 1 or -1
		end

		m.barPosition = target

		if m.perfect == false then Track.perfect = false end
	end)
end)

-- catch counter: a minigame handle that disappears is a finished one
task.spawn(function()
	local last, lastPerfect = nil, true
	while State.running do
		task.wait(0.15)
		local active = activeMinigame()
		if active then
			local ok, p = pcall(function() return active.perfect end)
			if ok then lastPerfect = p ~= false end
		end
		if last and not active then
			State.catches += 1
			Behavior.registerCatch(lastPerfect)
		end
		last = active
	end
end)

----------------------------------------------------------------------
-- feature: auto quests (reputation quests + daily challenge claim)
----------------------------------------------------------------------
-- One remote per pass, spaced out. The original fired select/claim for every
-- faction back to back, which is a burst no hand produces.
local function netRemote(kind, name)
	local ok, Net = pcall(require, ReplicatedStorage.packages.Net)
	if not ok then return nil end
	local ok2, r = pcall(function()
		return kind == "fn" and Net:RemoteFunction(name, -1) or Net:RemoteEvent(name)
	end)
	return ok2 and r or nil
end

local function playerData()
	local ok, m = pcall(require, ReplicatedStorage.client.modules.legacyLocalPlayerData)
	if not ok then return nil end
	local ok2, d = pcall(function() return m.fetch() end)
	return ok2 and d or nil
end

local function questController()
	local ok, m = pcall(require, ReplicatedStorage.client.legacyControllers.QuestController)
	return ok and m or nil
end

local questListLabel

local function questTick()
	local data = playerData()
	local qc = questController()
	if not (data and qc) then return end

	local selectRE = netRemote("ev", "ReputationQuests/SelectQuest")
	local claimRE = netRemote("ev", "ReputationQuests/ClaimQuest")
	if not (selectRE and claimRE) then return end

	local active, finished = data.QuestActive, data.QuestFinished
	local lines = {}
	local acted = false

	for _, faction in ipairs(data.ReputationQuests:GetChildren()) do
		local factionHasActive = false
		local quests = faction:GetChildren()

		for _, q in ipairs(quests) do
			if active:FindFirstChild(q.Name) then factionHasActive = true end
		end

		for _, q in ipairs(quests) do
			local isActive = active:FindFirstChild(q.Name) ~= nil
			local isDone = finished:FindFirstChild(q.Name) ~= nil
			local ready = qc.Completed and qc.Completed[q.Name]

			if not acted and ready and not isDone then
				task.wait(Behavior.reaction(1.6, 0.6, 0.7, 4.5))
				pcall(function() claimRE:FireServer(faction.Name, q.Name) end)
				State.questsClaimed += 1
				notify("Claimed quest · " .. faction.Name)
				acted, factionHasActive = true, false
			elseif not acted and not isActive and not isDone and not factionHasActive then
				task.wait(Behavior.reaction(1.6, 0.6, 0.7, 4.5))
				pcall(function() selectRE:FireServer(faction.Name, q.Name) end)
				factionHasActive = true
				notify("Accepted quest · " .. faction.Name)
				acted = true
			end

			if isActive then
				lines[#lines + 1] = "• " .. faction.Name .. (ready and "  (ready)" or "  (in progress)")
			end
		end
	end

	-- daily challenge: click the game's own claim button when it is offered.
	-- Activated only -- firing MouseButton1Click as well produced two events per click.
	if not acted then
		pcall(function()
			local hud = require(ReplicatedStorage.client.legacyControllers.HudController)
			local zone = hud:GetSafeZone()
			local ch = zone and zone:FindFirstChild("Challenges2")
			local cq = ch and ch:FindFirstChild("currentQuest")
			local claim = cq and cq:FindFirstChild("claimButton")
			if claim and claim.Visible and claim.Active then
				task.wait(Behavior.reaction(0.9, 0.35, 0.4, 2.5))
				fireListeners(claim.Activated)
			end
		end)
	end

	if questListLabel then
		questListLabel.Text = #lines > 0 and table.concat(lines, "\n") or "No active reputation quests."
	end
end

task.spawn(function()
	while State.running do
		task.wait(gauss(72, 22, 40, 145))
		if State.autoQuest then pcall(questTick) end
	end
end)

----------------------------------------------------------------------
-- feature: walkspeed
----------------------------------------------------------------------
-- WalkSpeedController recomputes WalkSpeed as (16 + sum of speed attributes), and
-- "DeveloperBoots" is one of its additive sources -- so writing it survives every
-- recalculation instead of fighting the game.
--
-- What does NOT survive is the server: Humanoid.WalkSpeed replicates from your client,
-- so whatever number you pick is a number Fisch can read. Hence the cap and the ramp.
local speedTween = nil

local function setBoots(v)
	local c = character()
	if not c then return end
	if v <= 0 then
		c:SetAttribute("DeveloperBoots", nil)
	else
		c:SetAttribute("DeveloperBoots", v)
	end
end

local function desiredBonus()
	if CFG.speedOnlyIdle and rodBusy() then return 0 end
	return math.clamp(State.walkSpeed, 16, CFG.maxWalkSpeed) - 16
end

-- ramp instead of snap: a step change from 16 to 28 in one frame is a shape
-- no player input produces
local function applySpeed()
	local c = character()
	if not c then return end
	local goal = desiredBonus()
	local cur = c:GetAttribute("DeveloperBoots") or 0
	if math.abs(goal - cur) < 0.05 then return end

	if speedTween then speedTween = nil end
	task.spawn(function()
		local id = os.clock()
		speedTween = id
		local t0, from = os.clock(), cur
		local dur = 0.45 + math.abs(goal - from) * 0.02
		while speedTween == id and os.clock() - t0 < dur do
			local a = (os.clock() - t0) / dur
			setBoots(from + (goal - from) * (1 - (1 - a) ^ 2))
			RunService.Heartbeat:Wait()
		end
		if speedTween == id then setBoots(goal) end
	end)
end

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1.5)
	if State.running then applySpeed() end
end)

task.spawn(function()
	while State.running do
		task.wait(0.6)
		pcall(applySpeed)
	end
end)

