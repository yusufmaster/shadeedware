--]]

-- ICON_FILE is a local file in the executor's workspace ROOT (AppData\Local\Potassium\workspace).
-- Potassium's getcustomasset only resolves files at that root -- a subfolder path returns a
-- URL that silently decodes to 0x0 -- so keep the image there rather than in a folder.
-- The loader fills SHADEEDWARE_ICONS with one workspace file per bundled picture. Each picture needs
-- its own filename: Roblox caches a getcustomasset URL for the whole session, so overwriting one
-- file keeps showing the first image.
local ICON_RNG = Random.new()
