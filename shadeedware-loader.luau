local function resolveIcon()
	if ICON_ID ~= "" then
		if tonumber(ICON_ID) then return "rbxassetid://" .. ICON_ID end
		return ICON_ID
	end

	-- local file, through the executor
	local gca = glob("getcustomasset") or glob("getsynasset")
	local isf = glob("isfile")
	if gca and ICON_FILE ~= "" then
		local present = true
		if isf then
			local okc, r = pcall(isf, ICON_FILE)
			present = okc and r == true
		end
		if present then
			local ok, asset = pcall(gca, ICON_FILE)
			if ok and type(asset) == "string" and asset ~= "" then return asset end
		end
	end
	local ok, url = pcall(function()
		return Players:GetUserThumbnailAsync(
			LocalPlayer.UserId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size420x420
		)
	end)
	return ok and url or ""
end
local ICON = resolveIcon()

local function avatar(size, ringThickness)
	local holder = new("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	new("Frame", {
		Parent = holder, Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.panel2,
	}, { circle(), stroke(T.accent, ringThickness or 2, 0.15) })
	local img = new("ImageLabel", {
		Parent = holder,
		Size = UDim2.new(1, -(ringThickness or 2) * 2, 1, -(ringThickness or 2) * 2),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = T.panel2,
		Image = ICON,
		ScaleType = Enum.ScaleType.Crop,
	}, { circle() })
	if ICON == "" then
		new("TextLabel", {
			Parent = img, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
			Text = "B", Font = Enum.Font.GothamBold, TextSize = math.floor(size * 0.45),
			TextColor3 = T.accent,
		})
	end
	return holder, img
end

