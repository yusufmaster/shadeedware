local eggBusy = false

-- Roblox won't play video files from the workspace, so the loader ships each clip as sprite
-- sheets (a flipbook) plus an mp3, and this steps through the frames in time with the audio.
local function eggVideo(gca, clip)
	local sheets = {}
	for i, f in ipairs(clip.sheets) do
		local ok, src = pcall(gca, f)
		if not ok or type(src) ~= "string" or src == "" then eggBusy = false return end
		sheets[i] = src
	end

	local overlay = new("TextButton", {
		Parent = gui, Size = UDim2.fromScale(1, 1), ZIndex = 10000, Text = "", AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
	})
	local holder = new("Frame", {
		Parent = overlay, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10001,
	}, { new("UIAspectRatioConstraint", { AspectRatio = clip.w / clip.h }) })

	-- hidden sheets sit at 0.99 rather than 1 so Roblox still loads them
	local labels = {}
	for i, src in ipairs(sheets) do
		labels[i] = new("ImageLabel", {
			Parent = holder, Size = UDim2.fromScale(1, 1), ZIndex = 10002, BackgroundTransparency = 1,
			Image = src, ImageTransparency = 0.99, ImageRectSize = Vector2.new(clip.w, clip.h),
		})
	end

	local sound
	local okA, audio = false, nil
	if clip.audio then okA, audio = pcall(gca, clip.audio) end -- controller-only GIFs are silent
	if okA and type(audio) == "string" and audio ~= "" then
		sound = new("Sound", { Parent = game:GetService("SoundService"), SoundId = audio, Volume = 1 })
	end

	pcall(function() game:GetService("ContentProvider"):PreloadAsync(labels) end)
	local deadline = os.clock() + 3
	while os.clock() < deadline do
		local ready = not sound or sound.IsLoaded
		for _, l in ipairs(labels) do ready = ready and l.IsLoaded end
		if ready then break end
		task.wait()
	end

	local skip = new("TextButton", {
		Parent = holder, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(84, 32), ZIndex = 10003, AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(15, 15, 18), BackgroundTransparency = 0.15,
		Text = "SKIP  »", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.new(1, 1, 1),
	}, { corner(8), stroke(Color3.new(1, 1, 1), 1.5, 0.25) })

	local done, conn = false, nil
	local function finish()
		if done then return end
		done = true
		skip.Visible = false
		if conn then conn:Disconnect() end
		if sound then sound:Destroy() end
		tween(overlay, 0.25, { BackgroundTransparency = 1 })
		for _, l in ipairs(labels) do tween(l, 0.25, { ImageTransparency = 1 }) end
		task.delay(0.3, function()
			overlay:Destroy()
			eggBusy = false
		end)
	end
	overlay.MouseButton1Click:Connect(finish)
	skip.MouseButton1Click:Connect(finish)
	overlay.Destroying:Connect(finish)

	tween(overlay, 0.15, { BackgroundTransparency = 0.35 })
	if sound then sound:Play() end
	local perSheet = clip.cols * clip.rows
	local start, shown = os.clock(), nil
	conn = RunService.RenderStepped:Connect(function()
		local idx = math.floor((os.clock() - start) * clip.fps)
		if idx >= clip.frames then finish() return end
		local l = labels[idx // perSheet + 1]
		local cell = idx % perSheet
		if shown ~= l then
			if shown then shown.ImageTransparency = 0.99 end
			l.ImageTransparency = 0
			shown = l
		end
		l.ImageRectOffset = Vector2.new((cell % clip.cols) * clip.w, (cell // clip.cols) * clip.h)
	end)
end

-- each cycle opens with every clip, then the pictures with another clip after every EGG_VIDEO_GAP
local EGG_VIDEO_GAP = 3

local function eggCycle()
	local vids, imgs = {}, {}
	for _, v in ipairs(VIDEO_POOL) do table.insert(vids, "vid:" .. v.audio) end
	for _, f in ipairs(ICON_POOL) do table.insert(imgs, "img:" .. f) end
	local queue = shuffled(vids)
	local extra, e = shuffled(vids), 0
	for i, item in ipairs(shuffled(imgs)) do
		table.insert(queue, item)
		if #extra > 0 and i % EGG_VIDEO_GAP == 0 and i < #imgs then
			e = e % #extra + 1
			table.insert(queue, extra[e])
		end
	end
	return queue
end

-- Puts one gallery item up full-screen: "img:<file>" for a picture, "vid:<audio>" for a clip.
-- The toggle egg below rolls for one at random; remote popups name the one they want.
local function eggShow(pick, holdFor)
	if eggBusy then return false end
	local gca = glob("getcustomasset") or glob("getsynasset")
	if not gca then return false end
	-- a bundled clip by its audio file, or a controller-only GIF by its id
	for _, v in ipairs(VIDEO_POOL) do
		if pick == "vid:" .. v.audio then
			eggBusy = true
			task.spawn(eggVideo, gca, v)
			return true
		end
	end
	for _, v in ipairs(REMOTE_POOL.anims) do
		if pick == "vid:" .. v.id then
			eggBusy = true
			task.spawn(eggVideo, gca, v)
			return true
		end
	end
	if string.sub(pick, 1, 4) == "vid:" then return false end
	local ok, src = pcall(gca, pick:sub(5))
	if not ok or type(src) ~= "string" or src == "" then return false end
	eggBusy = true
	local img = new("ImageLabel", {
		Parent = gui, Size = UDim2.fromScale(1, 1), ZIndex = 10000,
		BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
		Image = src, ImageTransparency = 1, ScaleType = Enum.ScaleType.Fit,
	})
	tween(img, 0.15, { ImageTransparency = 0, BackgroundTransparency = 0.35 })
	task.delay(holdFor or 1.6, function()
		tween(img, 0.3, { ImageTransparency = 1, BackgroundTransparency = 1 })
		task.wait(0.35)
		img:Destroy()
		eggBusy = false
	end)
	return true
end

local function easterEgg()
	if eggBusy or ICON_RNG:NextInteger(1, 5) ~= 1 then return end
	if not (glob("getcustomasset") or glob("getsynasset")) then return end
	local valid = {}
	for _, f in ipairs(ICON_POOL) do valid["img:" .. f] = true end
	for _, v in ipairs(VIDEO_POOL) do valid["vid:" .. v.audio] = true end
	local pick = nextInCycle("egg", valid, eggCycle)
	if pick then eggShow(pick) end
end

-- Remote popups -------------------------------------------------------
-- shadeedware-controller.luau puts a picture or clip up on every copy of this that is
-- running anywhere: other servers, the other games the loader covers, other PCs. They meet
-- on a channel at ntfy.sh, a free relay with no account behind it -- the controller POSTs a
-- short note and each copy hears it over a WebSocket about half a second later. A note can
-- only name something already in this copy's own gallery, so anyone else who learns the
-- channel can do no more than the controller does: show one of these pictures.
local BROADCAST_CHANNEL = "shadeedware-81d548b891f85a0d7d60" -- must match the controller

do
	local HttpService = game:GetService("HttpService")
	local WS = glob("WebSocket")
	local req = glob("request") or glob("http_request") or (syn and syn.request)
	local url = "ntfy.sh/" .. BROADCAST_CHANNEL
	local alive, sock = true, nil
	local seen = {}

	local function onNote(raw)
		local ok, ev = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok or type(ev) ~= "table" or ev.event ~= "message" or seen[ev.id] then return end
		seen[ev.id] = true
		-- held by the relay while this copy was away: old news by now
		if type(ev.time) == "number" and os.time() - ev.time > 60 then return end
		local okN, note = pcall(HttpService.JSONDecode, HttpService, ev.message or "")
		if not okN or type(note) ~= "table" then return end

		-- The named item if this copy has it, otherwise a random one of the same kind -- and the
		-- random pick only ever comes from the regular gallery: the controller-only extras show up
		-- when they are asked for by name, never by chance.
		local pick
		if note.kind == "vid" then
			for _, v in ipairs(VIDEO_POOL) do
				if v.audio == note.name then pick = "vid:" .. v.audio end
			end
			for _, v in ipairs(REMOTE_POOL.anims) do
				if v.id == note.name then pick = "vid:" .. v.id end
			end
			if not pick and #VIDEO_POOL > 0 then
				pick = "vid:" .. VIDEO_POOL[ICON_RNG:NextInteger(1, #VIDEO_POOL)].audio
			end
		end
		if not pick then
			for _, f in ipairs(ICON_POOL) do
				if f == note.name then pick = "img:" .. f end
			end
			for _, f in ipairs(REMOTE_POOL.images) do
				if f == note.name then pick = "img:" .. f end
			end
			pick = pick or "img:" .. ICON_POOL[ICON_RNG:NextInteger(1, #ICON_POOL)]
		end
		local hold = math.clamp(tonumber(note.secs) or 3, 1, 10)

		task.spawn(function()
			-- wait out a popup that is already up instead of dropping this one
			local giveUp = os.clock() + 8
			while eggBusy and os.clock() < giveUp do task.wait(0.2) end
			eggShow(pick, hold)
		end)
	end

	-- closing or re-running the hub destroys its window; the listener goes with it
	gui.Destroying:Connect(function()
		alive = false
		if sock then pcall(function() sock:Close() end) end
	end)

	task.spawn(function()
		local since = tostring(os.time())
		local backoff = 2
		while alive do
			if WS then
				-- A live connection: notes land the moment they are sent. ntfy sends a keepalive
				-- every 45s, so a minute and a half of silence means it died without saying so.
				local ok, s = pcall(WS.connect, "wss://" .. url .. "/ws")
				if ok and s then
					sock, backoff = s, 2
					State.relay = "live"
					local closed, heard = false, os.clock()
					s.OnMessage:Connect(function(raw)
						heard = os.clock()
						onNote(raw)
					end)
					s.OnClose:Connect(function() closed = true end)
					while alive and not closed and os.clock() - heard < 90 do task.wait(1) end
					pcall(function() s:Close() end)
				end
				State.relay = "reconnecting…"
			elseif req then
				-- no WebSocket on this executor: ask the relay every few seconds instead
				local ok, res = pcall(req, {
					Url = "https://" .. url .. "/json?poll=1&since=" .. since, Method = "GET",
				})
				if ok and res and res.StatusCode == 200 then
					backoff = 2
					State.relay = "polling"
					for line in string.gmatch(res.Body or "", "[^\n]+") do
						local okE, ev = pcall(HttpService.JSONDecode, HttpService, line)
						if okE and type(ev) == "table" and ev.id then since = ev.id end
						onNote(line)
					end
				end
			else
				State.relay = "off — no web access"
				return
			end
			if not alive then break end
			task.wait(WS and backoff or 6)
			backoff = math.min(backoff * 2, 60)
		end
	end)
end

local function toggle(page, order, title, desc, default, cb)
	local r = row(page, order, desc and 52 or 42)

	new("TextLabel", {
		Parent = r, Size = UDim2.new(1, -60, 0, 16),
		Position = UDim2.fromOffset(0, desc and 11 or 13),
		BackgroundTransparency = 1, Text = title, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
	})
	if desc then
		new("TextLabel", {
			Parent = r, Size = UDim2.new(1, -60, 0, 14), Position = UDim2.fromOffset(0, 28),
			BackgroundTransparency = 1, Text = desc, TextXAlignment = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.muted,
		})
	end

	local sw = new("TextButton", {
		Parent = r, Size = UDim2.fromOffset(40, 22),
		Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = T.panel2, AutoButtonColor = false, Text = "",
	}, { circle(), stroke(T.stroke, 1, 0.3) })

	local knob = new("Frame", {
		Parent = sw, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = T.muted,
	}, { circle() })

	local on = default and true or false
	local function render(animate)
		local t = animate and 0.18 or 0
		tween(sw, t, { BackgroundColor3 = on and T.accent or T.panel2 })
		tween(knob, t, {
			Position = UDim2.fromOffset(on and 21 or 3, 3),
			BackgroundColor3 = on and Color3.fromRGB(22, 16, 8) or T.muted,
		})
	end
	render(false)

	sw.MouseButton1Click:Connect(function()
		on = not on
		render(true)
		task.spawn(cb, on)
		pcall(easterEgg)
	end)

	-- setter so code can flip the switch without a click
	return function(v)
		if v == nil then return on end
		on = v and true or false
		render(true)
		return on
	end
end

local function slider(page, order, title, min, max, default, suffix, cb)
	local r = row(page, order, 60)

	new("TextLabel", {
		Parent = r, Size = UDim2.new(1, -70, 0, 16), Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1, Text = title, TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.text,
	})
	local valLbl = new("TextLabel", {
		Parent = r, Size = UDim2.fromOffset(64, 20),
		Position = UDim2.new(1, 0, 0, 10), AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = T.panel2, Text = tostring(default) .. (suffix or ""),
		Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = T.accent,
	}, { corner(6) })

	local bar = new("Frame", {
		Parent = r, Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromOffset(0, 40),
		BackgroundColor3 = T.panel2,
	}, { corner(3) })
	local prog = new("Frame", {
		Parent = bar, BackgroundColor3 = T.accent,
		Size = UDim2.fromScale((default - min) / (max - min), 1),
	}, { corner(3), new("UIGradient", { Color = ColorSequence.new(T.accent2, T.accent) }) })
	local knob = new("Frame", {
		Parent = bar, Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.text,
	}, { circle(), stroke(T.bg, 2, 0) })

	local hit = new("TextButton", {
		Parent = r, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 31),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
	})

	local value = default
	local dragging = false

	local function label(v)
		return ((max - min) <= 10 and string.format("%.2f", v) or tostring(math.floor(v + 0.5))) .. (suffix or "")
	end
	valLbl.Text = label(default)

	local function set(v, fire)
		value = math.clamp(v, min, max)
		local a = (value - min) / (max - min)
		prog.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valLbl.Text = label(value)
		if fire then task.spawn(cb, value) end
	end

	local function fromX(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		set(min + a * (max - min), true)
	end

	hit.MouseButton1Down:Connect(function()
		dragging = true
		tween(knob, 0.12, { Size = UDim2.fromOffset(18, 18) })
		fromX(UserInputService:GetMouseLocation().X)
	end)
	conns[#conns + 1] = UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				tween(knob, 0.12, { Size = UDim2.fromOffset(14, 14) })
			end
		end
	end)
	conns[#conns + 1] = UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(UserInputService:GetMouseLocation().X)
		end
	end)

	return set
end

