local function randomName()
	local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
	local out = {}
	for _ = 1, 14 do
		local i = math.random(1, #chars)
		out[#out + 1] = chars:sub(i, i)
	end
	return table.concat(out)
end

