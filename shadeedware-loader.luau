local function unload()
	if not State.running then return end
	State.running = false
	restoreSpeed()
	restoreCollision()
	pcall(RunService.UnbindFromRenderStep, RunService, AIM_BIND)
	pcall(RunService.UnbindFromRenderStep, RunService, ESP_BIND)
	pcall(RunService.UnbindFromRenderStep, RunService, DESYNC_BIND)
	pcall(unhookWallbang)
	desyncActive = false
	restoreDesyncStash()
	ghost:Destroy()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for player in pairs(espEntries) do removePlayer(player) end
	pcall(function() fovCircle:Remove() end)
	pcall(function() aimDot:Remove() end)
	fadeGroup(win, 0, 0.18)
	tween(winScale, 0.2, { Scale = 0.9 })
	task.delay(0.28, function()
		gui:Destroy()
		espFolder:Destroy()
		if unloadBeacon then unloadBeacon:Destroy() end
	end)
	if getgenv then getgenv().__SHADEED_IA = nil end
end

if unloadBeacon then unloadBeacon.Event:Connect(unload) end

