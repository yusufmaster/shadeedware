-- Fires a signal's Lua listeners on fresh threads. `:Fire()` runs them inline,
-- which blows up on Fisch's handlers (they yield) -- so call .Function directly.
local function fireListeners(signal, ...)
	local args = table.pack(...)

	if getconnections then
		local ok, conns = pcall(getconnections, signal)
		if ok and type(conns) == "table" and #conns > 0 then
			local hit = false
			for _, c in ipairs(conns) do
				local okf, f = pcall(function() return c.Function end)
				if okf and type(f) == "function" then
					hit = true
					task.spawn(f, table.unpack(args, 1, args.n))
				end
			end
			if hit then return true end

			-- no readable .Function: fall back to the connection's own Fire
			for _, c in ipairs(conns) do
				task.spawn(function()
					pcall(function() c:Fire(table.unpack(args, 1, args.n)) end)
				end)
				hit = true
			end
			if hit then return true end
		end
	end

	if firesignal then
		local ok = pcall(firesignal, signal, ...)
		if ok then return true end
	end

	return false
end

