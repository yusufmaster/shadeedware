task.spawn(function()
	while State.running do
		task.wait(0.25)
		pcall(function()
			local st, rod = rodState()
			local mg = activeMinigame()
			local label, col = "Idle", T.muted

			if Behavior.isPaused() and not mg then
				label, col = string.format("%s · %ds", Behavior.breakReason,
					math.ceil(Behavior.pauseUntil - os.clock())), T.warn
			elseif mg then
				label, col = (rawget(getmetatable(mg) or {}, "type") == "stab" and "Stabbing" or "Reeling"), T.accent2
			elseif PlayerGui:FindFirstChild("shakeui") then
				label, col = "Shaking", T.accent
			elseif walkingToWater then
				label, col = "Walking to water", T.accent
			elseif casting then
				label, col = "Charging cast", T.accent
			elseif st == ROD_STATE.Searching then
				label, col = "Waiting for a bite", T.accent2
			elseif st == ROD_STATE.Luring then
				label, col = "Fish is biting", T.accent
			elseif not rod then
				label, col = "No rod equipped", T.muted
			elseif st == ROD_STATE.Equipped then
				label, col = "Ready", T.muted
			end

			State.status = label
			statusText.Text = label
			headerSub.Text = string.lower(label)
			tween(statusDot, 0.2, { BackgroundColor3 = col })
			statsText.Text = string.format("%d casts · %d catches", State.casts, State.catches)

			local h = humanoid()
			if h then
				local live = math.floor(h.WalkSpeed + 0.5)
				speedRead.Text = string.format("  live: %d", live)
				speedRead.TextColor3 = live > 22 and T.warn or T.muted
			end
			if speedValLbl then
				speedValLbl.TextColor3 = State.walkSpeed > 22 and T.warn or T.accent
			end

			local secs = math.floor(os.clock() - State.startedAt)
			local cPct = Behavior.castTotal > 0 and (Behavior.castPerfect / Behavior.castTotal * 100) or 0
			local fPct = Behavior.catchTotal > 0 and (Behavior.catchPerfect / Behavior.catchTotal * 100) or 0
			sessionLbl.Text = string.format(
				"Runtime        %02d:%02d:%02d\nCasts          %d  (%.0f%% perfect)\nCatches        %d  (%.0f%% perfect)\nQuests         %d claimed\nBreaks         %d",
				secs // 3600, (secs % 3600) // 60, secs % 60,
				Behavior.castTotal, cPct, Behavior.catchTotal, fPct,
				State.questsClaimed, Behavior.breaksTaken
			)

			safetyRead.Text = string.format(
				"This hour      %d / %d\nNext break in  %d fish\nReaction drift ×%.2f\nHold           %s",
				Behavior.catchesThisHour(), CFG.catchesPerHour,
				math.max(0, Behavior.breakAt - Behavior.sinceBreak),
				Behavior.focus(),
				State.hold or "none"
			)
		end)
	end
end)

